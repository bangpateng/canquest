# /etc/nginx/snippets/canquest-admin-bff-secret.conf
# ─────────────────────────────────────────────────────────────────────────────
# Shared secret antara web BFF (Vercel) dan nginx VPS untuk /api/admin/*.
#
# Cara pakai (di VPS):
#   1. Buat secret baru, mis.: openssl rand -hex 32
#   2. Salin file ini TANPA akhiran .example:
#        cp canquest-admin-bff-secret.conf.example canquest-admin-bff-secret.conf
#   3. Ganti PASTE_SAME_SECRET_AS_VERCEL_ENV dengan secret tersebut.
#   4. Set nilai yang SAMA di Vercel → Project → Environment Variables:
#        ADMIN_BFF_SECRET=<secret>
#      lalu redeploy web.
#   5. sudo nginx -t && sudo systemctl reload nginx
#
# File TANPA .example sudah di-gitignore — jangan pernah commit nilai asli.
# Kalau file ini dihapus/diubah salah, `nginx -t` akan error (unknown
# variable $cq_admin_bff_ok) — itu sengaja fail-closed.
map $http_x_admin_bff_secret $cq_admin_bff_ok {
    default 0;
    "PASTE_SAME_SECRET_AS_VERCEL_ENV" 1;
}
