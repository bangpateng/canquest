-- ============================================================
-- CanQuest DAML Contract v27 (hybrid) — module Main
-- Package: canquest-v27 | SDK: 3.4.11
--
-- Templates:
--   1. WalletRegistration    — identitas on-chain (Party ID)
--   2. CampaignEligibility   — bukti lock CC / points per campaign
--   3. QuestCampaign         — kuota FCFS/Raffle + state machine + eligibility guard
--   4. PlatformTransfer      — send token + platform fee atomic
--   5. QuestPaymentRequest   — fee-tracking wrapper utk AppPaymentRequest (fee ONLY)
--
-- ⚠️ KOREKSI ARSITEKTUR v27 (verifikasi vs docs resmi Splice, docs.sync.global):
--   Premis awal v27 (1.4.0) salah — menganggap AppPaymentRequest bawa reward+fee.
--   Faktanya AppPaymentRequest adalah flow USER-BAYAR: sender = "the party that
--   should pay", provider "receives usage rewards". Splice TIDAK punya mekanisme
--   native platform→user reward (AppRewardCoupon dimiliki provider, bukan user).
--   Konsekuensi: reward delivery TETAP via CIP-56 TransferFactory_Transfer
--   (backend code, bukan DAML ini), tidak berubah dari v25. AppPaymentRequest
--   hanya dipakai utk FEE CLAIM (user→treasury) — yang memang kegunaan aslinya
--   dan memberi manfaat anti-preapproval nyata.
--
--   Jadi v27 adalah HYBRID:
--     • Fee claim (user → treasury) : AppPaymentRequest (locked, no preapproval)
--     • Reward (platform → user)    : CIP-56 TransferFactory_Transfer (backend)
--
-- CHANGE v26 → v27 (1.5.0 hybrid):
--   - HAPUS QuestClaimReceipt (LEGACY path — tidak ada user external)
--   - HAPUS field rewardSender dari ClaimSlot + DrawWinner args
--   - ClaimSlot + DrawWinner sekarang hanya return ContractId QuestCampaign
--   - QuestPaymentRequest: HAPUS field rewardAmount (cacat — AppPaymentRequest
--     hanya bawa fee, reward terpisah via CIP-56). Wrapper fee-tracking murni.
--   - Import tetap sama (TransferFactory dll masih dipakai PlatformTransfer)
--
-- ARSITEKTUR v27 (hybrid):
--
--   [EVENT CAMPAIGN CLAIM — fee via AppPaymentRequest, reward via CIP-56]
--   ClaimSlot / DrawWinner → return ContractId QuestCampaign
--   Backend create QuestPaymentRequest (PENDING, fee-tracking wrapper)
--   Backend create AppPaymentRequest (sender=user, receiver=treasury, fee ONLY)
--   Backend exercise AppPaymentRequest_Accept CUSTODIAL
--     (actAs=[user, walletProvider], backend pegang CanActAsAnyParty)
--     → dana fee terkunci di AcceptedAppPayment.lockedAmulet
--   Backend exercise QuestPaymentRequest.MarkAccepted
--   Backend exercise AcceptedAppPayment_Collect → fee cair ke treasury (no preapproval!)
--   Backend exercise QuestPaymentRequest.MarkSettled
--   Backend sendQuestRewardCip56 (reward wallet → user, via CIP-56) [hanya jika reward > 0]
--
--   [SEND TOKEN P2P + FEE]
--   Backend create PlatformTransfer → exercise ExecuteTransfer
--   3 leg atomic: transfer + fee + FAR marker
--
-- TIDAK ADA DI DAML (handled Splice DAR / Ledger API / backend):
--   - AppPaymentRequest create/accept/collect → via Ledger API backend
--   - Reward delivery → CIP-56 TransferFactory_Transfer (backend, unchanged)
--   - Lock CC → AmuletRules_Transfer + LockedAmulet
--   - TransferPreapproval → AmuletRules_CreateTransferPreapproval
--
-- actAs backend:
--   ClaimSlot / DrawWinner          : [admin]
--   QuestPaymentRequest choices     : [admin]
--   AppPaymentRequest_Accept        : [userAddress, walletProviderParty] (custodial)
--   AcceptedAppPayment_Collect      : [admin, userAddress, platformParty, treasuryParty]
--   PlatformTransfer.ExecuteTransfer: [admin, userAddress] (+ appProvider bila FAR on)
--   Semua lainnya                   : [admin]
--
-- FAR (FeaturedAppRight):
--   - PlatformTransfer.ExecuteTransfer → FAR manual (Leg 3)
--   - AppPaymentRequest path → FAR built-in di AcceptedAppPayment_Collect
--     (tidak perlu manual, cukup set provider = platformParty)
-- ============================================================

module Main where

import DA.Foldable (forA_)
import Splice.Api.Token.TransferInstructionV1
  ( TransferFactory(..)
  , TransferFactory_Transfer(..)
  , Transfer(..)
  )
import Splice.Api.Token.MetadataV1 (ExtraArgs(..))
import Splice.Api.FeaturedAppRightV2
  ( FeaturedAppRight(..)
  , FeaturedAppRight_CreateActivityMarker(..)
  , AppRewardBeneficiary(..)
  )


-- ============================================================
-- 1. WALLET REGISTRATION
--
--    FUNGSI:
--    Menyimpan identitas user on-chain saat pertama kali
--    connect wallet ke CanQuest. Satu contract per user.
--
--    KAPAN DIBUAT:
--    Backend exercise saat user register / connect wallet pertama kali.
--
--    SIAPA YANG BISA LIHAT:
--    - admin (signatory) → bisa buat dan query
--    - userAddress (observer) → bisa lihat contract miliknya
--
--    TIDAK ADA CHOICE:
--    Immutable — tidak bisa diubah setelah dibuat.
--    Kalau user update username dll → archive + create baru (backend-enforced).
--
--    actAs backend: [admin]
-- ============================================================

template WalletRegistration
  with
    admin         : Party   -- party admin CanQuest
    userAddress   : Party   -- party ID user (dari Keycloak/Canton)
    username      : Text    -- username display
    partyId       : Text    -- party ID string (untuk korelasi DB)
    inviteCode    : Text    -- kode invite yang dipakai saat register
    registeredAt  : Text    -- timestamp ISO8601
  where
    signatory admin
    observer userAddress


-- ============================================================
-- 2. CAMPAIGN ELIGIBILITY
--
--    FUNGSI:
--    Bukti on-chain bahwa user sudah memenuhi syarat untuk
--    ikut campaign tertentu. Di-fetch oleh ClaimSlot/DrawWinner
--    sebagai guard sebelum slot diberikan.
--
--    2 TIPE ELIGIBILITY:
--    "LOCK_CC" → user harus lock CC >= amount
--                DAN lock dilakukan SETELAH campaign dibuat
--                (guard: e.lockedAt > e.campaignCreatedAt)
--    "POINTS"  → user harus punya points >= amount
--                Points di-verify backend sebelum create contract ini
--
--    KAPAN DIBUAT:
--    Backend buat SETELAH verifikasi:
--      LOCK_CC → lock sukses di ledger + lockedAt > campaignCreatedAt
--      POINTS  → PointsService.getNetPoints(userId) >= amount
--
--    LIFECYCLE:
--    ELIGIBLE → [RevokeEligibility] → archived (user unlock CC sebelum campaign selesai)
--    ELIGIBLE → [ExpireEligibility] → archived (campaign CLOSED/ENDED)
--
--    KENAPA signatory admin (bukan user):
--    Agar ClaimSlot/DrawWinner di QuestCampaign bisa fetch contract ini
--    tanpa butuh authorization dari user (admin sudah cukup).
--
--    actAs backend: [admin]
-- ============================================================

template CampaignEligibility
  with
    admin             : Party   -- party admin CanQuest
    userAddress       : Party   -- party user yang eligible
    campaignId        : Text    -- ID campaign yang berlaku
    campaignCreatedAt : Text    -- timestamp campaign dibuat (untuk validasi lock)
    eligibilityType   : Text    -- "LOCK_CC" | "POINTS"
    amount            : Decimal -- jumlah CC locked ATAU jumlah points
    lockedAt          : Text    -- kapan user lock CC (kosong string bila POINTS)
    expiresAt         : Text    -- eligibility berlaku sampai kapan
    status            : Text    -- "ELIGIBLE" (satu-satunya status aktif)
  where
    signatory admin
    observer userAddress

    -- Revoke: user unlock CC sebelum campaign selesai.
    -- Backend monitor unlock event dari ledger → exercise ini.
    -- Consuming (default) → contract di-archive.
    choice RevokeEligibility : ()
      with revokedAt : Text
      controller admin
      do
        assertMsg "Harus ELIGIBLE untuk revoke!" (status == "ELIGIBLE")
        assertMsg "revokedAt tidak boleh kosong!" (revokedAt /= "")
        return ()

    -- Expire: cleanup setelah campaign CLOSED atau ENDED.
    -- Backend scheduler jalankan ini saat campaign selesai.
    -- Consuming (default) → contract di-archive.
    choice ExpireEligibility : ()
      with expiredAt : Text
      controller admin
      do
        assertMsg "Harus ELIGIBLE untuk expire!" (status == "ELIGIBLE")
        assertMsg "expiredAt tidak boleh kosong!" (expiredAt /= "")
        return ()


-- ============================================================
-- 3. QUEST CAMPAIGN
--
--    FUNGSI:
--    Manajemen campaign quest on-chain:
--    - State machine status campaign
--    - Kuota slot FCFS atomic (anti-sybil concurrent claim)
--    - Draw pemenang Raffle/Waitlist
--    - Guard eligibility (lock CC atau points)
--
--    STATE MACHINE:
--    DRAFT → ACTIVE → PAUSED → ACTIVE (resume)
--                   → ENDED  → CLOSED
--                   → CLOSED (langsung)
--
--    QUEST KIND:
--    CC_FCFS           → reward CC, klaim FCFS
--    CC_RAFFLE         → reward CC, draw raffle
--    CODE_FCFS         → reward kode invite, klaim FCFS
--    CODE_RAFFLE       → reward kode invite, draw raffle
--    CC_AND_CODE_RAFFLE→ reward CC + kode, draw raffle
--    WAITLIST          → waitlist, admin draw manual
--
--    ELIGIBILITY TYPE:
--    "NONE"    → siapa saja bisa klaim
--    "LOCK_CC" → wajib lock CC >= eligibilityAmount (lock SETELAH campaign dibuat)
--    "POINTS"  → wajib punya points >= eligibilityAmount
--
--    CONSUMING CHOICES:
--    ClaimSlot + DrawWinner → consuming (auto-archive + create baru dengan
--    currentClaims+1). Ini yang bikin atomic anti-sybil — concurrent claim
--    akan conflict di ledger dan salah satu abort otomatis.
--
--    RETURN VALUE (v27):
--    ClaimSlot + DrawWinner sekarang hanya return ContractId QuestCampaign.
--    Backend yang create QuestPaymentRequest setelah slot berhasil diklaim.
--
--    actAs backend: [admin]
-- ============================================================

template QuestCampaign
  with
    admin             : Party
    campaignId        : Text
    title             : Text
    questKind         : Text    -- CC_FCFS|CC_RAFFLE|CODE_FCFS|CODE_RAFFLE|CC_AND_CODE_RAFFLE|WAITLIST
    rewardCc          : Decimal -- jumlah reward CC (0.0 bila kode)
    rewardToken       : Optional Text -- None/"CC" = Amulet; "USDCx" = token non-CC
    claimFeeCc        : Decimal -- fee yang dibayar user saat klaim
    maxWinners        : Int     -- 0 = unlimited
    currentClaims     : Int     -- counter slot terpakai
    status            : Text    -- "DRAFT"|"ACTIVE"|"PAUSED"|"ENDED"|"CLOSED"
    eligibilityType   : Text    -- "NONE"|"LOCK_CC"|"POINTS"
    eligibilityAmount : Decimal -- min CC locked atau min points (0.0 bila NONE)
    createdAt         : Text
  where
    signatory admin

    -- ── FCFS CLAIM ───────────────────────────────────────────
    -- User klaim slot FCFS secara atomic.
    --
    -- KENAPA ATOMIC:
    -- Choice ini consuming → ledger archive contract lama + create baru.
    -- Kalau 2 user klaim bersamaan → ledger conflict → salah satu abort.
    -- Ini yang bikin anti-sybil tanpa perlu lock/mutex di backend.
    --
    -- GUARD ELIGIBILITY:
    -- Fetch CampaignEligibility on-chain dan validasi semua field.
    -- Bila eligibilityType = "NONE" → skip fetch, langsung klaim.
    --
    -- RETURN: ContractId QuestCampaign (baru, currentClaims+1)
    -- Backend baca contractId baru ini, lalu create QuestPaymentRequest.
    --
    -- actAs backend: [admin]
    choice ClaimSlot : ContractId QuestCampaign
      with
        user           : Party
        claimId        : Text
        claimedAt      : Text
        eligibilityCid : Optional (ContractId CampaignEligibility)
      controller admin
      do
        assertMsg "Campaign harus ACTIVE!" (status == "ACTIVE")
        assertMsg "questKind harus FCFS!"
          (questKind == "CC_FCFS" || questKind == "CODE_FCFS")
        assertMsg "Kuota FCFS sudah habis!"
          (maxWinners == 0 || currentClaims < maxWinners)

        case eligibilityType of
          "LOCK_CC" -> case eligibilityCid of
            None -> assertMsg "User harus lock CC dulu!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!" (e.status == "ELIGIBLE")
              assertMsg "Jumlah lock CC kurang dari minimum!"
                (e.amount >= eligibilityAmount)
              assertMsg "Lock CC harus dilakukan setelah campaign dibuat!"
                (e.lockedAt > e.campaignCreatedAt)
          "POINTS" -> case eligibilityCid of
            None -> assertMsg "User harus punya points cukup!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!" (e.status == "ELIGIBLE")
              assertMsg "Points kurang dari minimum!"
                (e.amount >= eligibilityAmount)
          _ -> pure ()

        create this with
          currentClaims = currentClaims + 1

    -- ── RAFFLE / WAITLIST DRAW ────────────────────────────────
    -- Admin draw pemenang raffle atau waitlist.
    -- Hanya admin yang bisa exercise — user tidak bisa self-draw.
    -- Guard eligibility sama dengan ClaimSlot.
    --
    -- RETURN: ContractId QuestCampaign (baru, currentClaims+1)
    -- Backend baca contractId baru ini, lalu create QuestPaymentRequest.
    --
    -- actAs backend: [admin]
    choice DrawWinner : ContractId QuestCampaign
      with
        user           : Party
        claimId        : Text
        drawnAt        : Text
        eligibilityCid : Optional (ContractId CampaignEligibility)
      controller admin
      do
        assertMsg "Campaign harus ACTIVE!" (status == "ACTIVE")
        assertMsg "Kuota raffle sudah habis!"
          (maxWinners == 0 || currentClaims < maxWinners)
        assertMsg "questKind harus RAFFLE/WAITLIST!"
          ( questKind == "CC_RAFFLE"
         || questKind == "CODE_RAFFLE"
         || questKind == "CC_AND_CODE_RAFFLE"
         || questKind == "WAITLIST" )

        case eligibilityType of
          "LOCK_CC" -> case eligibilityCid of
            None -> assertMsg "User harus lock CC dulu!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!" (e.status == "ELIGIBLE")
              assertMsg "Jumlah lock CC kurang dari minimum!"
                (e.amount >= eligibilityAmount)
              assertMsg "Lock CC harus dilakukan setelah campaign dibuat!"
                (e.lockedAt > e.campaignCreatedAt)
          "POINTS" -> case eligibilityCid of
            None -> assertMsg "User harus punya points cukup!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!" (e.status == "ELIGIBLE")
              assertMsg "Points kurang dari minimum!"
                (e.amount >= eligibilityAmount)
          _ -> pure ()

        create this with
          currentClaims = currentClaims + 1

    -- ── STATE MACHINE ─────────────────────────────────────────
    -- Semua consuming → archive lama + create baru dengan status baru.

    -- DRAFT/PAUSED → ACTIVE
    choice Activate : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Hanya DRAFT/PAUSED → ACTIVE."
          (status == "DRAFT" || status == "PAUSED")
        assertMsg "updatedAt tidak boleh kosong!" (updatedAt /= "")
        create this with status = "ACTIVE"

    -- ACTIVE → PAUSED
    choice Pause : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Campaign harus ACTIVE untuk pause!" (status == "ACTIVE")
        assertMsg "updatedAt tidak boleh kosong!" (updatedAt /= "")
        create this with status = "PAUSED"

    -- ACTIVE → ENDED
    choice EndCampaign : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Campaign harus ACTIVE untuk end!" (status == "ACTIVE")
        assertMsg "updatedAt tidak boleh kosong!" (updatedAt /= "")
        create this with status = "ENDED"

    -- ACTIVE/ENDED → CLOSED (final, consuming tanpa create baru)
    choice Close : ()
      with closedAt : Text
      controller admin
      do
        assertMsg "closedAt tidak boleh kosong!" (closedAt /= "")
        assertMsg "Hanya ACTIVE/ENDED → CLOSED."
          (status == "ACTIVE" || status == "ENDED")
        return ()


-- ============================================================
-- 4. PLATFORM TRANSFER
--
--    FUNGSI:
--    Kirim token (CC/USDCx) dari user ke receiver + potong
--    platform fee ke treasury, semua dalam 1 transaksi atomik.
--
--    KAPAN DIPAKAI:
--    User kirim CC atau USDCx ke user lain via fitur send di dapp.
--    BUKAN untuk reward claim campaign → pakai QuestPaymentRequest.
--
--    3 LEG ATOMIC (all-or-nothing):
--    Leg 1: user → receiver (jumlah yang dikirim)
--    Leg 2: user → treasury (platform fee)
--    Leg 3: FAR marker → app rewards ke appProvider (bila FAR on)
--
--    MULTI-TOKEN:
--    CC dan USDCx didukung via instrumentId di Transfer spec.
--    Field token di contract hanya untuk tracking/display.
--
--    MULTI-CONTROLLER:
--    admin + userAddress wajib co-controller karena kedua leg
--    sender = user → butuh authorization user.
--
--    LIFECYCLE:
--    PENDING → [ExecuteTransfer] → SETTLED
--    PENDING → [CancelTransfer]  → archived
--
--    actAs backend: [admin, userAddress] (+ appProvider bila FAR on)
-- ============================================================

template PlatformTransfer
  with
    admin       : Party
    userAddress : Party
    transferId  : Text    -- UUID internal untuk korelasi DB
    amount      : Decimal -- jumlah yang dikirim ke receiver
    feeAmount   : Decimal -- platform fee ke treasury
    receiver    : Party   -- penerima transfer
    treasury    : Party   -- wallet treasury platform
    token       : Text    -- "CC" | "USDCx" (untuk display/tracking)
    status      : Text    -- "PENDING" | "SETTLED"
    createdAt   : Text
  where
    signatory admin
    observer userAddress

    -- ATOMIC EXECUTE
    -- Leg 1 + Leg 2 + Leg 3 dalam 1 tx tree.
    -- Bila salah satu leg gagal → semua rollback.
    choice ExecuteTransfer : ContractId PlatformTransfer
      with
        transferFactoryCid  : ContractId TransferFactory -- factory untuk leg 1
        transferSpec        : Transfer                   -- detail transfer ke receiver
        transferExtraArgs   : ExtraArgs                  -- metadata leg 1
        feeFactoryCid       : ContractId TransferFactory -- factory untuk leg 2
        feeSpec             : Transfer                   -- detail transfer fee
        feeExtraArgs        : ExtraArgs                  -- metadata leg 2
        featuredAppRightCid : Optional (ContractId FeaturedAppRight) -- None = FAR off
        appProvider         : Party                      -- party FAR (CANTON_APP_PROVIDER_PARTY_ID)
        settledAt           : Text
      controller admin, userAddress
      do
        assertMsg "Status harus PENDING!" (status == "PENDING")
        assertMsg "Amount harus > 0!" (amount > 0.0)
        assertMsg "Fee harus > 0!" (feeAmount > 0.0)
        assertMsg "settledAt tidak boleh kosong!" (settledAt /= "")

        -- Leg 1: Transfer utama ke receiver
        _ <- exercise transferFactoryCid TransferFactory_Transfer with
          expectedAdmin = transferSpec.instrumentId.admin
          transfer      = transferSpec
          extraArgs     = transferExtraArgs

        -- Leg 2: Platform fee ke treasury
        _ <- exercise feeFactoryCid TransferFactory_Transfer with
          expectedAdmin = feeSpec.instrumentId.admin
          transfer      = feeSpec
          extraArgs     = feeExtraArgs

        -- Leg 3: FAR marker (skip bila None)
        forA_ featuredAppRightCid $ \farCid -> do
          exercise farCid FeaturedAppRight_CreateActivityMarker with
            beneficiaries = [ AppRewardBeneficiary
              { beneficiary = appProvider
              , weight      = 1.0
              } ]
            weight = None

        create this with status = "SETTLED"

    -- Cancel sebelum execute
    choice CancelTransfer : ()
      with cancelledAt : Text
      controller admin
      do
        assertMsg "Hanya PENDING yang bisa dicancel!" (status == "PENDING")
        assertMsg "cancelledAt tidak boleh kosong!" (cancelledAt /= "")
        return ()


-- ============================================================
-- 5. QUEST PAYMENT REQUEST (fee-tracking wrapper, v27 hybrid)
--
--    FUNGSI:
--    State tracker on-chain untuk lifecycle AppPaymentRequest
--    (template dari Splice DAR — bukan milik CanQuest).
--
--    ⚠️ SCOPE: HANYA FEE CLAIM (user → treasury).
--    Reward (platform → user) TIDAK lewat sini — reward via CIP-56
--    TransferFactory_Transfer di backend (lihat header file). Splice tidak
--    punya mekanisme native platform→user reward (verified vs docs Splice).
--    Makanya TIDAK ada field rewardAmount di template ini.
--
--    KENAPA TEMPLATE INI ADA:
--    AppPaymentRequest adalah milik Splice DAR, bukan Daml kamu.
--    Kamu tidak bisa tambah field atau logic ke dalamnya.
--    QuestPaymentRequest adalah "wrapper" milik kamu di ledger
--    agar backend bisa:
--    - Korelasi claimId ↔ AppPaymentRequest contractId
--    - Track status FEE claim on-chain (audit trail)
--    - Query status dari Ledger API
--
--    KAPAN DIPAKAI:
--    Semua reward claim event campaign — FCFS maupun Raffle/Waitlist.
--    Untuk semua user, tidak peduli ada/tidak TransferPreapproval.
--
--    KENAPA TIDAK BUTUH PREAPPROVAL (utk fee):
--    AppPaymentRequest_Accept (custodial, oleh backend atas nama user)
--    mengunci fee di AcceptedAppPayment.lockedAmulet. Collect langsung
--    konsumsi locked amulet — direct, no preapproval dari treasury.
--    (Reward tetap butuh preapproval user — itu fragilitas yang TIDAK
--     bisa di-fix oleh AppPaymentRequest, karena reward arahnya terbalik.)
--
--    KENAPA TIDAK PERLU FAR MANUAL:
--    AcceptedAppPayment_Collect sudah built-in generate app rewards
--    ke field `provider` di AppPaymentRequest.
--    Cukup set provider = platformParty saat create AppPaymentRequest.
--
--    LIFECYCLE:
--    PENDING  → [MarkAccepted] → ACCEPTED
--             → [MarkExpired]  → archived
--    ACCEPTED → [MarkSettled]  → SETTLED
--             → [MarkExpired]  → archived
--
--    FIELD appPaymentRequestCid (Text, bukan ContractId):
--    Disimpan sebagai Text karena AppPaymentRequest di-archive
--    setelah Accept — tidak bisa di-fetch lagi sebagai ContractId aktif.
--    Setelah MarkAccepted, field ini di-update ke AcceptedAppPayment contractId.
--
--    FLOW LENGKAP (FEE ONLY):
--    1. Backend create QuestPaymentRequest (status PENDING)
--    2. Backend create AppPaymentRequest via Ledger API
--       → sender = userAddress (user yang BAYAR fee)
--       → receiverAmounts = [(treasuryParty, feeAmount)]   -- FEE ONLY
--       → provider = platformParty (CANTON_APP_PROVIDER_PARTY_ID)
--    3. Backend exercise AppPaymentRequest_Accept CUSTODIAL
--       (actAs = [userAddress, walletProviderParty], backend pegang CanActAsAnyParty)
--       → Return: acceptedAppPaymentCid + senderChangeAmulet
--    4. Backend exercise MarkAccepted (simpan acceptedAppPaymentCid)
--    5. Backend exercise AcceptedAppPayment_Collect
--       → Return: receiverAmulets + collectTxId (fee cair ke treasury)
--    6. Backend exercise MarkSettled (simpan collectTxId)
--    [TERPISAH] Backend sendQuestRewardCip56 (reward wallet → user) bila reward > 0
--
--    actAs backend: [admin] untuk semua choices di template ini
-- ============================================================

template QuestPaymentRequest
  with
    admin                : Party
    userAddress          : Party
    campaignId           : Text
    claimId              : Text   -- korelasi ke slot yang diklaim di QuestCampaign
    requestId            : Text   -- UUID internal untuk korelasi DB
    appPaymentRequestCid : Text   -- contractId AppPaymentRequest (Text)
                                  -- di-update ke AcceptedAppPayment cid setelah Accept
    feeAmount            : Decimal -- platform fee ke treasury (FEE ONLY — reward via CIP-56)
    token                : Text   -- "CC" | "USDCx"
    status               : Text   -- "PENDING"|"ACCEPTED"|"SETTLED"|"EXPIRED"
    createdAt            : Text
    expiresAt            : Text   -- sama dengan AppPaymentRequest.expiresAt
  where
    signatory admin
    observer userAddress

    -- ── MARK ACCEPTED ─────────────────────────────────────────
    -- Dipanggil backend setelah user exercise AppPaymentRequest_Accept.
    --
    -- KAPAN DIPANGGIL:
    -- Backend subscribe Ledger API event stream → detect
    -- AppPaymentRequest_Accept → exercise MarkAccepted.
    --
    -- acceptedAppPaymentCid: contractId AcceptedAppPayment
    -- (dibutuhkan backend untuk exercise AcceptedAppPayment_Collect di step berikutnya)
    choice MarkAccepted : ContractId QuestPaymentRequest
      with
        acceptedAppPaymentCid : Text -- contractId AcceptedAppPayment
        acceptedAt            : Text
      controller admin
      do
        assertMsg "Harus PENDING untuk MarkAccepted!" (status == "PENDING")
        assertMsg "acceptedAppPaymentCid tidak boleh kosong!"
          (acceptedAppPaymentCid /= "")
        assertMsg "acceptedAt tidak boleh kosong!" (acceptedAt /= "")
        create this with
          status               = "ACCEPTED"
          appPaymentRequestCid = acceptedAppPaymentCid

    -- ── MARK SETTLED ──────────────────────────────────────────
    -- Dipanggil backend setelah AcceptedAppPayment_Collect sukses.
    --
    -- KAPAN DIPANGGIL:
    -- Backend exercise AcceptedAppPayment_Collect → sukses
    -- → baca collectTxId dari Ledger API response
    -- → exercise MarkSettled.
    --
    -- collectTxId: transaction ID dari AcceptedAppPayment_Collect
    -- (untuk audit trail dan korelasi DB)
    choice MarkSettled : ContractId QuestPaymentRequest
      with
        collectTxId : Text
        settledAt   : Text
      controller admin
      do
        assertMsg "Harus ACCEPTED untuk MarkSettled!" (status == "ACCEPTED")
        assertMsg "collectTxId tidak boleh kosong!" (collectTxId /= "")
        assertMsg "settledAt tidak boleh kosong!" (settledAt /= "")
        create this with
          status = "SETTLED"

    -- ── MARK EXPIRED ──────────────────────────────────────────
    -- Dipanggil backend scheduler untuk semua skenario gagal/batal.
    --
    -- KAPAN DIPANGGIL (4 skenario):
    -- 1. TIMEOUT   → user tidak respond sebelum expiresAt
    --                Backend exercise AppPaymentRequest_Expire dulu
    --                → lalu exercise MarkExpired dengan reason "TIMEOUT"
    -- 2. REJECTED  → user exercise AppPaymentRequest_Reject
    --                Backend detect event → exercise MarkExpired reason "REJECTED"
    -- 3. WITHDRAWN → platform batalkan sebelum user accept
    --                Backend exercise AppPaymentRequest_Withdraw dulu
    --                → lalu exercise MarkExpired reason "WITHDRAWN"
    -- 4. CANCELLED → AcceptedAppPayment_Expire (sudah accept tapi expired sebelum collect)
    --                Dana kembali ke user otomatis
    --                → Backend exercise MarkExpired reason "CANCELLED"
    --
    -- Consuming (default) → contract di-archive setelah expired.
    choice MarkExpired : ()
      with
        reason    : Text -- "TIMEOUT"|"REJECTED"|"WITHDRAWN"|"CANCELLED"
        expiredAt : Text
      controller admin
      do
        assertMsg "Harus PENDING atau ACCEPTED untuk MarkExpired!"
          (status == "PENDING" || status == "ACCEPTED")
        assertMsg "reason tidak boleh kosong!" (reason /= "")
        assertMsg "expiredAt tidak boleh kosong!" (expiredAt /= "")
        return ()
