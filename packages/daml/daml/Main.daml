-- ============================================================
-- CanQuest DAML Contract v29 — module Main
-- Package: canquest-v29 | SDK: 3.4.11
--
-- NOTE VERSI: v29 = konsolidasi seluruh iterasi workspace v29–v31
-- (security fixes audit + koreksi tipe TransferV2 + FIX-13/14/15).
-- Upgrade produksi berurutan: v28 → v29.
--
-- KOREKSI TIPE (dikonfirmasi via CIP-112 / dokumentasi resmi
--   Splice.Api.Token.TransferInstructionV2 & HoldingV2):
--   Transfer.sender dan Transfer.receiver bertipe Account (BUKAN Party):
--     Account = { owner : Optional Party, provider : Optional Party, id : Text }
--     Transfer = { sender : Account, receiver : Account, amount, instrumentId,
--                  requestedAt, executeBefore, inputHoldingCids, meta }
--     InstrumentId = { admin : Party, id : Text }
--   Validasi v30 pakai perbandingan Party langsung (feeTransfer.sender ==
--   userAddress) SALAH — tidak compile karena sender bukan Party.
--   Kontrak ini pakai .owner (Optional Party):
--     feeTransfer.sender.owner == Some userAddress
--   Field `actors : [Party]` pada TransferFactory_Transfer diisi dari Party
--   hasil ekstraksi .owner (basicAccount), bukan dari Account itu sendiri.
--
--   [FIX-8]  Settle + ExecuteTransfer: validasi fee/transfer receiver
--            on-chain (trustedTreasury / treasury)
--   [FIX-9]  Settle + ExecuteTransfer: pin instrumentId ke token resmi
--            (trustedInstrumentAdmin + trustedInstrumentId)
--   [FIX-10] rewardCode tidak bocor sebelum Settle → kode asli di
--            SecretRewardCode (admin-only, tanpa observer user),
--            di-reveal ke Receipt hanya setelah status SETTLED
--   [FIX-11] Cross-check e.lockId == Some l.lockId di ClaimSlot/DrawWinner
--   [FIX-12] DIHAPUS di v30: contract key (campaignId/claimId/lockId,
--            serta (admin, campaignId, userAddress) di CampaignEligibility)
--            TIDAK dipakai lagi. Contract keys butuh Daml-LF 2.3+
--            (Canton 3.5 / Protocol Version 35), belum didukung SDK 3.4.11.
--            Tidak ada choice di kontrak ini yang pakai fetchByKey/
--            lookupByKey, jadi penghapusan ini aman secara fungsional.
--            KONSEKUENSI: uniqueness campaignId/claimId/lockId dan
--            "1 eligibility aktif per user per campaign" TIDAK lagi
--            dijamin on-chain — harus divalidasi di backend/off-chain
--            sebelum submit transaksi (cek duplikat di database dulu).
--
-- TEMPLATES (9):
--   1. WalletRegistrationProposal
--   2. WalletRegistration
--   3. CampaignEligibility
--   4. QuestCampaign
--   5. QuestClaimReceipt
--   6. PlatformTransfer
--   7. CoinLockProposal
--   8. CoinLock
--   9. SecretRewardCode
-- ============================================================

module Main where

import DA.Foldable (forA_)
import Splice.Api.Token.TransferInstructionV2
  ( TransferFactory(..)
  , TransferFactory_Transfer(..)
  , Transfer(..)
  )
import Splice.Api.Token.MetadataV1 (ExtraArgs(..))
import Splice.Api.FeaturedAppRightV2
  ( FeaturedAppRight(..)
  , FeaturedAppRight_CreateActivityMarker(..)
  , AppRewardBeneficiary(..)
  )

-- ============================================================
-- 1. WALLET REGISTRATION PROPOSAL  (unchanged)
-- ============================================================
template WalletRegistrationProposal
  with
    admin          : Party
    userAddress    : Party
    userProfileRef : Text
    partyId        : Text
    registeredAt   : Text
  where
    signatory admin
    observer userAddress

    choice Accept : ContractId WalletRegistration
      controller userAddress
      do
        create WalletRegistration with
          admin          = admin
          userAddress    = userAddress
          userProfileRef = userProfileRef
          partyId        = partyId
          registeredAt   = registeredAt

-- ============================================================
-- 2. WALLET REGISTRATION  (unchanged)
-- ============================================================
template WalletRegistration
  with
    admin          : Party
    userAddress    : Party
    userProfileRef : Text
    partyId        : Text
    registeredAt   : Text
  where
    signatory admin, userAddress

-- ============================================================
-- 3. CAMPAIGN ELIGIBILITY
--
--    [FIX-12] key (admin, campaignId, userAddress) — lihat catatan
--    desain di header file ini sebelum deploy.
-- ============================================================
template CampaignEligibility
  with
    admin             : Party
    userAddress       : Party
    campaignId        : Text
    campaignCreatedAt : Text
    eligibilityType   : Text
    amount            : Decimal
    lockId            : Optional Text
    lockedAt          : Text
    expiresAt         : Text
    status            : Text
    usedInClaimId     : Optional Text
  where
    signatory admin
    observer userAddress

    choice UseEligibility : ()
      with claimId : Text
      controller admin
      do
        assertMsg "Harus ELIGIBLE!" (status == "ELIGIBLE")
        assertMsg "Sudah dipakai di klaim lain!" (usedInClaimId == None)
        assertMsg "claimId tidak boleh kosong!" (claimId /= "")
        return ()

    choice RevokeEligibility : ContractId CampaignEligibility
      with revokedAt : Text
      controller admin
      do
        assertMsg "Harus ELIGIBLE untuk revoke!" (status == "ELIGIBLE")
        assertMsg "revokedAt tidak boleh kosong!" (revokedAt /= "")
        create this with status = "REVOKED"

    choice ExpireEligibility : ContractId CampaignEligibility
      with expiredAt : Text
      controller admin
      do
        assertMsg "Harus ELIGIBLE untuk expire!" (status == "ELIGIBLE")
        assertMsg "expiredAt tidak boleh kosong!" (expiredAt /= "")
        create this with status = "EXPIRED"

-- ============================================================
-- 4. QUEST CAMPAIGN
-- ============================================================
template QuestCampaign
  with
    admin                   : Party
    campaignId              : Text
    title                   : Text
    questKind               : Text
    rewardCc                : Decimal
    rewardToken             : Optional Text
    claimFeeCc              : Decimal
    maxWinners              : Int
    currentClaims           : Int
    status                  : Text
    eligibilityType         : Text
    eligibilityAmount       : Decimal
    trustedRewardWallet     : Party
    trustedAppProvider      : Party
    trustedTreasury         : Party
    trustedInstrumentAdmin  : Party
    trustedInstrumentId     : Text
    createdAt               : Text
  where
    signatory admin

    -- [FIX-13] claimFeeCc wajib > 0: tanpa ini campaign fee-0 bisa
    --   diklaim tapi Settle selalu gagal ("Fee harus > 0!") sehingga
    --   receipt macet di PRE_SETTLE selamanya.
    -- [FIX-14] Whitelist questKind + eligibilityType: mencegah nilai
    --   asing/typo dari backend lolos — dulu eligibilityType di luar
    --   LOCK_CC/POINTS masuk cabang `_ -> pure ()` = klaim TANPA cek
    --   eligibility sama sekali.
    ensure claimFeeCc > 0.0
      && rewardCc >= 0.0
      && maxWinners >= 0
      && eligibilityAmount >= 0.0
      && ( questKind == "CC_FCFS" || questKind == "CODE_FCFS"
           || questKind == "CC_RAFFLE" || questKind == "CODE_RAFFLE"
           || questKind == "CC_AND_CODE_RAFFLE" || questKind == "WAITLIST" )
      && (eligibilityType == "LOCK_CC" || eligibilityType == "POINTS")
      && not (
          (questKind == "CC_FCFS" || questKind == "CC_RAFFLE"
            || questKind == "CC_AND_CODE_RAFFLE")
          && rewardCc == 0.0)

    -- ── FCFS CLAIM ───────────────────────────────────────────
    choice ClaimSlot : (ContractId QuestCampaign, ContractId QuestClaimReceipt)
      with
        user           : Party
        claimId        : Text
        claimedAt      : Text
        rewardSender   : Party
        eligibilityCid : Optional (ContractId CampaignEligibility)
        lockCid        : Optional (ContractId CoinLock)
      controller admin
      do
        assertMsg "Campaign harus ACTIVE!" (status == "ACTIVE")
        assertMsg "questKind harus FCFS!"
          (questKind == "CC_FCFS" || questKind == "CODE_FCFS")
        assertMsg "Kuota FCFS sudah habis!"
          (maxWinners == 0 || currentClaims < maxWinners)
        assertMsg "rewardSender bukan wallet resmi!"
          (rewardSender == trustedRewardWallet)

        case eligibilityType of
          "LOCK_CC" -> case eligibilityCid of
            None -> assertMsg "User harus lock CC dulu!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!" (e.status == "ELIGIBLE")
              assertMsg "Sudah dipakai di klaim lain!" (e.usedInClaimId == None)
              assertMsg "Jumlah lock CC kurang dari minimum!"
                (e.amount >= eligibilityAmount)
              assertMsg "Lock CC harus setelah campaign dibuat!"
                (e.lockedAt > e.campaignCreatedAt)
              case lockCid of
                None -> assertMsg "CoinLock wajib untuk LOCK_CC!" False
                Some lCid -> do
                  l <- fetch lCid
                  assertMsg "CoinLock bukan milik user ini!"
                    (l.userAddress == user)
                  assertMsg "CoinLock harus LOCKED!" (l.status == "LOCKED")
                  assertMsg "Jumlah lock tidak sesuai eligibility!"
                    (l.amount == e.amount)
                  assertMsg "CoinLock tidak sesuai eligibility!"
                    (e.lockId == Some l.lockId)
              exercise eCid UseEligibility with claimId = claimId
          "POINTS" -> case eligibilityCid of
            None -> assertMsg "User harus punya points cukup!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!" (e.status == "ELIGIBLE")
              assertMsg "Sudah dipakai di klaim lain!" (e.usedInClaimId == None)
              assertMsg "Points kurang dari minimum!"
                (e.amount >= eligibilityAmount)
              exercise eCid UseEligibility with claimId = claimId
          _ -> pure ()

        newCampaignCid <- create this with currentClaims = currentClaims + 1
        newClaimCid <- create QuestClaimReceipt with
          admin                  = admin
          campaignId             = campaignId
          userAddress            = user
          claimId                = claimId
          claimKind              = questKind
          rewardCc               = rewardCc
          rewardToken            = rewardToken
          rewardCode             = ""
          hasRewardCode          = False   -- ClaimSlot tidak pernah bawa kode
          rewardSender           = rewardSender
          trustedAppProvider     = trustedAppProvider
          trustedTreasury        = trustedTreasury
          trustedInstrumentAdmin = trustedInstrumentAdmin
          trustedInstrumentId    = trustedInstrumentId
          claimFeeCc             = claimFeeCc
          feePaid                = False
          feeTxId                = None
          rewardSent             = False
          rewardTxId             = None
          status                 = "PRE_SETTLE"
          claimedAt              = claimedAt
        pure (newCampaignCid, newClaimCid)

    -- ── RAFFLE / WAITLIST DRAW ────────────────────────────────
    choice DrawWinner
        : (ContractId QuestCampaign, ContractId QuestClaimReceipt,
           Optional (ContractId SecretRewardCode))
      with
        user           : Party
        claimId        : Text
        rewardCode     : Optional Text
        drawnAt        : Text
        rewardSender   : Party
        eligibilityCid : Optional (ContractId CampaignEligibility)
        lockCid        : Optional (ContractId CoinLock)
      controller admin
      do
        assertMsg "Campaign harus ACTIVE!" (status == "ACTIVE")
        assertMsg "Kuota raffle sudah habis!"
          (maxWinners == 0 || currentClaims < maxWinners)
        assertMsg "questKind harus RAFFLE/WAITLIST!"
          ( questKind == "CC_RAFFLE" || questKind == "CODE_RAFFLE"
            || questKind == "CC_AND_CODE_RAFFLE" || questKind == "WAITLIST" )
        assertMsg "rewardSender bukan wallet resmi!"
          (rewardSender == trustedRewardWallet)
        assertMsg "Quest kode wajib sertakan rewardCode!"
          (not (questKind == "CODE_RAFFLE" || questKind == "CC_AND_CODE_RAFFLE")
           || rewardCode /= None)

        case eligibilityType of
          "LOCK_CC" -> case eligibilityCid of
            None -> assertMsg "User harus lock CC dulu!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!" (e.status == "ELIGIBLE")
              assertMsg "Sudah dipakai di klaim lain!" (e.usedInClaimId == None)
              assertMsg "Jumlah lock CC kurang dari minimum!"
                (e.amount >= eligibilityAmount)
              assertMsg "Lock CC harus setelah campaign dibuat!"
                (e.lockedAt > e.campaignCreatedAt)
              case lockCid of
                None -> assertMsg "CoinLock wajib untuk LOCK_CC!" False
                Some lCid -> do
                  l <- fetch lCid
                  assertMsg "CoinLock bukan milik user ini!"
                    (l.userAddress == user)
                  assertMsg "CoinLock harus LOCKED!" (l.status == "LOCKED")
                  assertMsg "Jumlah lock tidak sesuai eligibility!"
                    (l.amount == e.amount)
                  assertMsg "CoinLock tidak sesuai eligibility!"
                    (e.lockId == Some l.lockId)
              exercise eCid UseEligibility with claimId = claimId
          "POINTS" -> case eligibilityCid of
            None -> assertMsg "User harus punya points cukup!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!" (e.status == "ELIGIBLE")
              assertMsg "Sudah dipakai di klaim lain!" (e.usedInClaimId == None)
              assertMsg "Points kurang dari minimum!"
                (e.amount >= eligibilityAmount)
              exercise eCid UseEligibility with claimId = claimId
          _ -> pure ()

        newCampaignCid <- create this with currentClaims = currentClaims + 1

        newClaimCid <- create QuestClaimReceipt with
          admin                  = admin
          campaignId             = campaignId
          userAddress            = user
          claimId                = claimId
          claimKind              = questKind
          rewardCc               = rewardCc
          rewardToken            = rewardToken
          rewardCode             = ""
          hasRewardCode          = rewardCode /= None  -- [FIX] reflect kondisi asli, bukan hardcode False
          rewardSender           = rewardSender
          trustedAppProvider     = trustedAppProvider
          trustedTreasury        = trustedTreasury
          trustedInstrumentAdmin = trustedInstrumentAdmin
          trustedInstrumentId    = trustedInstrumentId
          claimFeeCc             = claimFeeCc
          feePaid                = False
          feeTxId                = None
          rewardSent             = False
          rewardTxId             = None
          status                 = "PRE_SETTLE"
          claimedAt              = drawnAt

        secretCid <- case rewardCode of
          None -> pure None
          Some code -> do
            cid <- create SecretRewardCode with
              admin   = admin
              claimId = claimId
              code    = code
            pure (Some cid)

        pure (newCampaignCid, newClaimCid, secretCid)

    -- ── STATE MACHINE  (unchanged) ────────────────────────────
    choice Activate : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Hanya DRAFT/PAUSED → ACTIVE."
          (status == "DRAFT" || status == "PAUSED")
        assertMsg "updatedAt tidak boleh kosong!" (updatedAt /= "")
        create this with status = "ACTIVE"

    choice Pause : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Campaign harus ACTIVE untuk pause!" (status == "ACTIVE")
        create this with status = "PAUSED"

    choice EndCampaign : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Campaign harus ACTIVE untuk end!" (status == "ACTIVE")
        create this with status = "ENDED"

    choice Close : ()
      with closedAt : Text
      controller admin
      do
        assertMsg "Hanya ACTIVE/ENDED → CLOSED."
          (status == "ACTIVE" || status == "ENDED")
        return ()

-- ============================================================
-- 5. QUEST CLAIM RECEIPT
--
--    Transfer.sender / Transfer.receiver bertipe Account (V2) —
--    validasi pakai .owner (Optional Party), lihat catatan di header.
-- ============================================================
template QuestClaimReceipt
  with
    admin                   : Party
    campaignId               : Text
    userAddress               : Party
    claimId                   : Text
    claimKind                 : Text
    rewardCc                  : Decimal
    rewardToken               : Optional Text
    rewardCode                : Text
    hasRewardCode             : Bool
    rewardSender               : Party
    trustedAppProvider         : Party
    trustedTreasury             : Party
    trustedInstrumentAdmin      : Party
    trustedInstrumentId         : Text
    claimFeeCc                  : Decimal
    feePaid                     : Bool
    feeTxId                     : Optional Text
    rewardSent                  : Bool
    rewardTxId                  : Optional Text
    status                      : Text
    claimedAt                   : Text
  where
    signatory admin
    observer userAddress

    -- [FIX-13] klaim tanpa fee tidak bisa di-settle, jadi tolak di sini juga
    ensure rewardCc >= 0.0 && claimFeeCc > 0.0

    -- ── ATOMIC SETTLE ─────────────────────────────────────────
    choice Settle : ContractId QuestClaimReceipt
      with
        feeFactoryCid       : ContractId TransferFactory
        feeTransfer         : Transfer
        feeExtraArgs        : ExtraArgs
        rewardFactoryCid    : Optional (ContractId TransferFactory)
        rewardTransfer      : Optional Transfer
        rewardExtraArgs     : Optional ExtraArgs
        featuredAppRightCid : Optional (ContractId FeaturedAppRight)
        appProvider         : Party
        settledAt           : Text
      controller admin, userAddress, rewardSender
      do
        assertMsg "Claim harus PRE_SETTLE!" (status == "PRE_SETTLE")
        assertMsg "Fee harus > 0!" (claimFeeCc > 0.0)

        assertMsg "Fee amount tidak sesuai kontrak!"
          (feeTransfer.amount == claimFeeCc)

        -- Transfer.sender/.receiver : Account (V2) — akses via .owner
        assertMsg "Fee sender harus userAddress!"
          (feeTransfer.sender.owner == Some userAddress)

        assertMsg "Fee receiver harus treasury resmi!"
          (feeTransfer.receiver.owner == Some trustedTreasury)

        assertMsg "Fee instrument bukan token resmi!"
          ( feeTransfer.instrumentId.admin == trustedInstrumentAdmin
            && feeTransfer.instrumentId.id == trustedInstrumentId )

        assertMsg "appProvider tidak valid!"
          (appProvider == trustedAppProvider)

        -- [FIX-15] Campaign berreward CC (rewardCc > 0) WAJIB menyertakan
        -- transfer reward on-chain. Dulu rewardFactoryCid = None sah →
        -- receipt "SETTLED" tanpa reward terkirim (perlindungan dari
        -- bug/misconfig backend yang submit atas nama semua controller).
        assertMsg "Klaim berreward CC wajib sertakan transfer reward!"
          ( rewardCc == 0.0
            || ( rewardFactoryCid /= None
                 && rewardTransfer /= None
                 && rewardExtraArgs /= None ) )

        feeSenderParty <- case feeTransfer.sender.owner of
          Some p -> pure p
          None -> abort "Fee sender account tidak punya owner!"

        _ <- exercise feeFactoryCid TransferFactory_Transfer with
          transfer  = feeTransfer
          actors    = [feeSenderParty]
          extraArgs = feeExtraArgs

        rewardActuallySent <- case rewardFactoryCid of
          None -> pure False
          Some rfd -> case rewardTransfer of
            None -> pure False
            Some rt -> case rewardExtraArgs of
              None -> pure False
              Some rea -> do
                assertMsg "Reward amount tidak sesuai kontrak!"
                  (rt.amount == rewardCc)
                assertMsg "Reward sender tidak valid!"
                  (rt.sender.owner == Some rewardSender)
                assertMsg "Reward receiver harus userAddress!"
                  (rt.receiver.owner == Some userAddress)
                assertMsg "Reward instrument bukan token resmi!"
                  ( rt.instrumentId.admin == trustedInstrumentAdmin
                    && rt.instrumentId.id == trustedInstrumentId )
                rewardSenderParty <- case rt.sender.owner of
                  Some p -> pure p
                  None -> abort "Reward sender account tidak punya owner!"
                _ <- exercise rfd TransferFactory_Transfer with
                  transfer  = rt
                  actors    = [rewardSenderParty]
                  extraArgs = rea
                pure True

        forA_ featuredAppRightCid $ \farCid -> do
          exercise farCid FeaturedAppRight_CreateActivityMarker with
            beneficiaries = [ AppRewardBeneficiary
              { beneficiary = appProvider
              , weight      = 1.0
              } ]
            weight = None

        create this with
          feePaid    = True
          rewardSent = rewardActuallySent
          status     = "SETTLED"

    choice RecordTxId : ContractId QuestClaimReceipt
      with feeTxId : Text; rewardTxId : Optional Text
      controller admin
      do
        assertMsg "Claim harus SETTLED!" (status == "SETTLED")
        create this with
          feeTxId    = Some feeTxId
          rewardTxId = rewardTxId

    choice RevealCode : ContractId QuestClaimReceipt
      with code : Text; revealedAt : Text
      controller admin
      do
        assertMsg "Harus SETTLED sebelum reveal kode!" (status == "SETTLED")
        assertMsg "code tidak boleh kosong!" (code /= "")
        create this with
          rewardCode    = code
          hasRewardCode = True
          status        = "REVEALED"

    choice Expire : ()
      with expiredAt : Text
      controller admin
      do
        assertMsg "Hanya PRE_SETTLE yang bisa expire!" (status == "PRE_SETTLE")
        return ()

-- ============================================================
-- 6. PLATFORM TRANSFER
-- ============================================================
template PlatformTransfer
  with
    admin                    : Party
    userAddress               : Party
    transferId                 : Text
    amount                      : Decimal
    feeAmount                   : Decimal
    receiver                    : Party
    treasury                    : Party
    trustedInstrumentAdmin      : Party
    trustedInstrumentId         : Text
    token                       : Text
    status                      : Text
    createdAt                   : Text
  where
    signatory admin
    observer userAddress

    ensure amount > 0.0 && feeAmount > 0.0

    choice ExecuteTransfer : ContractId PlatformTransfer
      with
        transferFactoryCid  : ContractId TransferFactory
        transferSpec        : Transfer
        transferExtraArgs   : ExtraArgs
        feeFactoryCid       : ContractId TransferFactory
        feeSpec             : Transfer
        feeExtraArgs        : ExtraArgs
        featuredAppRightCid : Optional (ContractId FeaturedAppRight)
        appProvider         : Party
        settledAt           : Text
      controller admin, userAddress
      do
        assertMsg "Status harus PENDING!" (status == "PENDING")

        assertMsg "Tidak bisa kirim ke diri sendiri!"
          (userAddress /= receiver)
        assertMsg "Tidak bisa kirim ke treasury!"
          (receiver /= treasury)

        assertMsg "Transfer amount tidak sesuai kontrak!"
          (transferSpec.amount == amount)
        assertMsg "Fee amount tidak sesuai kontrak!"
          (feeSpec.amount == feeAmount)

        assertMsg "Transfer sender harus userAddress!"
          (transferSpec.sender.owner == Some userAddress)
        assertMsg "Fee sender harus userAddress!"
          (feeSpec.sender.owner == Some userAddress)

        assertMsg "Transfer receiver tidak sesuai kontrak!"
          (transferSpec.receiver.owner == Some receiver)
        assertMsg "Fee receiver harus treasury!"
          (feeSpec.receiver.owner == Some treasury)

        assertMsg "Transfer instrument bukan token resmi!"
          ( transferSpec.instrumentId.admin == trustedInstrumentAdmin
            && transferSpec.instrumentId.id == trustedInstrumentId )
        assertMsg "Fee instrument bukan token resmi!"
          ( feeSpec.instrumentId.admin == trustedInstrumentAdmin
            && feeSpec.instrumentId.id == trustedInstrumentId )

        transferSenderParty <- case transferSpec.sender.owner of
          Some p -> pure p
          None -> abort "Transfer sender account tidak punya owner!"
        feeSenderParty <- case feeSpec.sender.owner of
          Some p -> pure p
          None -> abort "Fee sender account tidak punya owner!"

        _ <- exercise transferFactoryCid TransferFactory_Transfer with
          transfer  = transferSpec
          actors    = [transferSenderParty]
          extraArgs = transferExtraArgs

        _ <- exercise feeFactoryCid TransferFactory_Transfer with
          transfer  = feeSpec
          actors    = [feeSenderParty]
          extraArgs = feeExtraArgs

        forA_ featuredAppRightCid $ \farCid -> do
          exercise farCid FeaturedAppRight_CreateActivityMarker with
            beneficiaries = [ AppRewardBeneficiary
              { beneficiary = appProvider
              , weight      = 1.0
              } ]
            weight = None

        create this with status = "SETTLED"

    choice CancelTransfer : ()
      with cancelledAt : Text
      controller admin
      do
        assertMsg "Hanya PENDING yang bisa dicancel!" (status == "PENDING")
        return ()

-- ============================================================
-- 7. COIN LOCK PROPOSAL  (unchanged)
-- ============================================================
template CoinLockProposal
  with
    admin        : Party
    userAddress  : Party
    lockId       : Text
    amount       : Decimal
    durationDays : Int
    lockedAt     : Text
    expiresAt    : Text
    campaignId   : Optional Text
  where
    signatory admin
    observer userAddress

    ensure amount > 0.0
      && (durationDays == 3 || durationDays == 7 || durationDays == 15)

    choice AcceptLock : ContractId CoinLock
      controller userAddress
      do
        assertMsg "lockId tidak boleh kosong!" (lockId /= "")
        assertMsg "lockedAt tidak boleh kosong!" (lockedAt /= "")
        assertMsg "expiresAt tidak boleh kosong!" (expiresAt /= "")
        create CoinLock with
          admin        = admin
          userAddress  = userAddress
          lockId       = lockId
          amount       = amount
          durationDays = durationDays
          lockedAt     = lockedAt
          expiresAt    = expiresAt
          campaignId   = campaignId
          status       = "LOCKED"

    choice CancelProposal : ()
      with reason : Text
      controller admin
      do
        assertMsg "reason tidak boleh kosong!" (reason /= "")
        return ()

-- ============================================================
-- 8. COIN LOCK
-- ============================================================
template CoinLock
  with
    admin        : Party
    userAddress  : Party
    lockId       : Text
    amount       : Decimal
    durationDays : Int
    lockedAt     : Text
    expiresAt    : Text
    campaignId   : Optional Text
    status       : Text
  where
    signatory admin, userAddress

    ensure amount > 0.0
      && (durationDays == 3 || durationDays == 7 || durationDays == 15)
      && (status == "LOCKED" || status == "UNLOCK_REQUESTED")

    choice RequestUnlock : ContractId CoinLock
      with requestedAt : Text
      controller userAddress
      do
        assertMsg "Harus LOCKED!" (status == "LOCKED")
        assertMsg "requestedAt tidak boleh kosong!" (requestedAt /= "")
        create this with status = "UNLOCK_REQUESTED"

    choice ConfirmUnlock : ()
      with confirmedAt : Text
      controller admin
      do
        assertMsg "Harus UNLOCK_REQUESTED!" (status == "UNLOCK_REQUESTED")
        assertMsg "confirmedAt tidak boleh kosong!" (confirmedAt /= "")
        return ()

    choice ForceUnlock : ()
      with reason : Text; forcedAt : Text
      controller admin
      do
        assertMsg "reason tidak boleh kosong!" (reason /= "")
        assertMsg "forcedAt tidak boleh kosong!" (forcedAt /= "")
        return ()

-- ============================================================
-- 9. SECRET REWARD CODE
--
--    Signatory admin saja — user TIDAK jadi observer, sehingga
--    kode tidak bisa dibaca lewat Ledger/JSON API oleh user
--    sebelum Reveal dipanggil (dan Reveal sendiri menolak jika
--    Receipt terkait belum SETTLED).
-- ============================================================
template SecretRewardCode
  with
    admin   : Party
    claimId : Text
    code    : Text
  where
    signatory admin

    ensure code /= ""

    choice Reveal : ContractId QuestClaimReceipt
      with
        receiptCid : ContractId QuestClaimReceipt
        revealedAt : Text
      controller admin
      do
        assertMsg "revealedAt tidak boleh kosong!" (revealedAt /= "")
        receipt <- fetch receiptCid
        assertMsg "Receipt harus SETTLED sebelum reveal!"
          (receipt.status == "SETTLED")
        assertMsg "claimId tidak cocok dengan receipt!"
          (receipt.claimId == claimId)
        exercise receiptCid RevealCode with
          code       = code
          revealedAt = revealedAt
