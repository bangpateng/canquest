-- ============================================================
-- CanQuest DAML Contract v22 — module Main
-- Package: canquest-v22  |  SDK: 3.4.11  |  Atomic Settle
--
-- 3 template (custodial admin/operator pattern).
-- Match backend apps/api/src/canton/quest-ledger.service.ts.
--
-- Templates:
--   1. WalletRegistration — jangkar identitas on-chain (Party ID)
--   2. QuestCampaign      — kuota FCFS/Raffle + state machine
--   3. QuestClaimReceipt  — receipt + ATOMIC Settle (nested CIP-56)
--
-- ── DAML BOUNDARY (sesuai rekomendasi Canton AI Q5) ──────────
-- DAML MILIK ANDA hanya urus Layer 2: Quest reward business logic:
--   - Anti-sybil kuota FCFS/Raffle (atomic on-chain)
--   - State machine campaign (DRAFT/ACTIVE/PAUSED/ENDED/CLOSED)
--   - Atomic settle (fee+reward dalam 1 transaction tree)
--   - Idempotency claim (contract key)
--   - Receipt + audit trail
--
-- DAML TIDAK urus (pure CIP-56 / DAR Splice bawaan):
--   - Send CC P2P          → TransferFactory_Transfer
--   - Send USDCx P2P       → TransferFactory_Transfer (instrumentId beda)
--   - Swap CC↔USDCx        → TransferFactory_Transfer (ke OneSwap depositParty)
--   - Lock/Unlock CC       → AmuletRules_Transfer + LockedAmulet
--   - Preapproval          → AmuletRules_CreateTransferPreapproval
--   - Offer Inbox          → TransferInstruction_Accept/Reject/Withdraw
-- Semua fungsi Wallet di atas SUDAH jalan tanpa DAML milik Anda.
--
-- ── ATOMICITY (quest reward claim) ───────────────────────────
-- Settle choice = nested sub-exercise di 1 transaction tree:
--   1. exercise feeFactoryCid  TransferFactory_Transfer (user→treasury)
--   2. exercise rewardFactoryCid TransferFactory_Transfer (reward→user)
--   3. (optional) exercise farCid FeaturedAppRight_CreateActivityMarker
-- Semua atomic all-or-nothing.
--
-- actAs command submission (backend):
--   - FAR off: [admin, userAddress, rewardParty]
--   - FAR on : [admin, userAddress, rewardParty, appProvider]
-- Service-account token (CanActAsAnyParty) bisa cover semua.
--
-- ── TX ID LIMITATION ─────────────────────────────────────────
-- TransferFactory_Transfer return TransferInstructionResult (record),
-- BUKAN tx ID. Tx ID tidak bisa didapat dari dalam choice.
-- Maka: Settle hanya set boolean feePaid/rewardSent + create settled receipt.
-- Tx ID diisi BELAKANGAN via choice RecordTxId (post-settlement,
-- backend baca tx ID dari Ledger API response setelah atomic command sukses).
--
-- ── PARTY MODEL (custodial) ──────────────────────────────────
-- signatory admin   — canquest-operator::... (signer DAML, match backend field "admin")
-- observer userAddress — user party (observer-only, tidak submit command)
-- Backend submit SEMUA command atas nama admin + co-actAs.
--
-- ── USDCx REWARD SUPPORT ─────────────────────────────────────
-- rewardToken : Optional Text  — None atau "CC" = Amulet (default)
--                            — "USDCx" = token non-CC
-- Backend createQuestCampaign kirim rewardToken eksplisit bila USDCx.
-- Settle choice tetap atomic; backend konstruksi transfer spec sesuai
-- rewardToken (instrumentId beda: "Amulet" vs "USDCx").
--
-- ── REWARD TYPE → questKind (match backend mapRewardTypeToQuestKind) ─
--   "CC_ONLY"             → CC_FCFS / CC_RAFFLE
--   "CC_MANUAL"           → CC_RAFFLE
--   "CC_AND_INVITE"       → CC_FCFS
--   "INVITE_CODE_FCFS"    → CODE_FCFS
--   "INVITE_CODE_RANDOM"  → CODE_RAFFLE
--   "CC_AND_CODE_RAFFLE"  → CC_AND_CODE_RAFFLE
--   "WAITLIST_EMAIL"      → WAITLIST
--
-- Docs: https://docs.canton.network/appdev/modules/m3-design-patterns
-- ============================================================

module Main where

import Daml.Script
import DA.Foldable (forA_)

-- Token Standard interfaces (data-dependencies, dari participant DAR)
import Splice.Api.Token.TransferInstructionV1
  ( TransferFactory
  , TransferFactory_Transfer
  , TransferInstructionResult
  , Transfer
  , ExtraArgs
  )
import Splice.Api.Token.HoldingV1 (Holding, InstrumentId)
import Splice.Api.Token.MetadataV1 (Metadata, ChoiceContext)
-- FAR di-comment sampai DAR splice-api-featured-app di-dapatkan dari bundle.
-- Build bisa jalan tanpa FAR (FAR off = status production sekarang).
-- Aktifkan kembali setelah dapat nama file DAR featured-app dari bundle.
-- import Splice.Api.FeaturedAppRightV2
--   ( FeaturedAppRight
--   , FeaturedAppRight_CreateActivityMarker
--   , AppRewardBeneficiary
--   )


-- ============================================================
-- 1. TEMPLATE WALLET REGISTRATION
--    Jangkar identitas on-chain. Dibuat saat user register wallet.
--    Create-only — tidak ada choice (state tidak berubah).
--    Match backend: QuestLedgerService.registerWallet()
--    Field match backend createContract args PERSIS.
-- ============================================================

template WalletRegistration
  with
    admin         : Party         -- canquest-operator (signer) — match backend field "admin"
    userAddress   : Party         -- user party (observer)
    username      : Text
    partyId       : Text          -- format: "username::1220..."
    inviteCode    : Text
    registeredAt  : Text          -- ISO-8601
  where
    signatory admin
    observer userAddress

    -- Idempotency: 1 WalletRegistration per (admin, userAddress).
    -- Backend registerWallet() cek ACS dulu sebelum create.
    key (admin, userAddress) : (Party, Party)
    maintainer key._1


-- ============================================================
-- 2. TEMPLATE QUEST CAMPAIGN
--    Kuota FCFS/Raffle + state machine, atomic on-chain.
--    Match backend: QuestLedgerService.createQuestCampaign()
--    Field match backend createContract args PERSIS:
--      admin, campaignId, title, questKind, rewardCc, claimFeeCc,
--      maxWinners, currentClaims, status, createdAt
--    + rewardToken (Optional, baru — untuk USDCx support)
--
--    State machine (anti-reopen CLOSED):
--      DRAFT → ACTIVE → PAUSED ↔ ACTIVE
--      ACTIVE → ENDED → CLOSED (archive via consuming choice, final)
--      ACTIVE → CLOSED
--    Status sebagai Text (bukan enum) supaya match backend kirim string.
-- ============================================================

template QuestCampaign
  with
    admin         : Party         -- canquest-operator (signer)
    campaignId    : Text
    title         : Text
    questKind     : Text          -- CC_FCFS | CC_RAFFLE | CODE_FCFS | CODE_RAFFLE | CC_AND_CODE_RAFFLE | WAITLIST
    rewardCc      : Decimal       -- jumlah reward (match backend field)
    rewardToken   : Optional Text -- None|"CC" = Amulet (default); "USDCx" = token non-CC
    claimFeeCc    : Decimal       -- fee claim (match backend field)
    maxWinners    : Int           -- 0 = unlimited
    currentClaims : Int
    status        : Text          -- "DRAFT"|"ACTIVE"|"PAUSED"|"ENDED"|"CLOSED"
    createdAt     : Text
  where
    signatory admin

    key (admin, campaignId) : (Party, Text)
    maintainer key._1

    -- FCFS: user klaim slot (CC_ONLY/CC_AND_INVITE/INVITE_CODE_FCFS).
    -- Kuota di-enforce atomic on-chain. Match backend claimFcfsSlot().
    -- Argumen match backend PERSIS: { user, claimId, claimedAt }
    -- Return: (Campaign baru dgn counter+1, QuestClaimReceipt baru).
    -- Consuming (default) — auto-archive, anti-sybil: 2 ClaimSlot concurrent
    -- pada contract sama → ledger conflict → salah abort.
    choice ClaimSlot : (ContractId QuestCampaign, ContractId QuestClaimReceipt)
      with
        user       : Party
        claimId    : Text
        claimedAt  : Text
      controller admin
      do
        assertMsg "Campaign harus ACTIVE!" (status == "ACTIVE")
        assertMsg "questKind harus FCFS!"
          (questKind == "CC_FCFS" || questKind == "CODE_FCFS")
        assertMsg "Kuota FCFS sudah habis!"
          (maxWinners == 0 || currentClaims < maxWinners)

        -- Consuming: auto-archive self.
        newCampaignCid <- create this with
          currentClaims = currentClaims + 1
        -- Create receipt child (status PRE_SETTLE, fee/reward belum dibayar).
        newClaimCid <- create QuestClaimReceipt with
          admin           = admin
          campaignId      = campaignId
          userAddress     = user
          claimId         = claimId
          claimKind       = questKind
          rewardCc        = rewardCc
          rewardToken     = rewardToken
          rewardCode      = ""
          claimFeeCc      = claimFeeCc
          feePaid         = False
          feeTxId         = None
          rewardSent      = False
          rewardTxId      = None
          status          = "PRE_SETTLE"
          claimedAt       = claimedAt
        pure (newCampaignCid, newClaimCid)

    -- Raffle/Waitlist: admin draw pemenang.
    -- Match backend drawRaffleWinner().
    -- Argumen match backend PERSIS: { user, claimId, rewardCode, drawnAt }
    -- questKind RAFFLE: CC_RAFFLE, CODE_RAFFLE, CC_AND_CODE_RAFFLE, WAITLIST.
    choice DrawWinner : (ContractId QuestCampaign, ContractId QuestClaimReceipt)
      with
        user        : Party
        claimId     : Text
        rewardCode  : Text        -- bisa "" (CC) atau kode invite
        drawnAt     : Text
      controller admin
      do
        assertMsg "Campaign harus ACTIVE!" (status == "ACTIVE")
        assertMsg "Kuota raffle sudah habis!"
          (maxWinners == 0 || currentClaims < maxWinners)
        assertMsg "questKind harus RAFFLE/WAITLIST!"
          ( questKind == "CC_RAFFLE"
         || questKind == "CODE_RAFFLE"
         || questKind == "CC_AND_CODE_RAFFLE"
         || questKind == "WAITLIST" )

        newCampaignCid <- create this with
          currentClaims = currentClaims + 1
        newClaimCid <- create QuestClaimReceipt with
          admin           = admin
          campaignId      = campaignId
          userAddress     = user
          claimId         = claimId
          claimKind       = questKind
          rewardCc        = rewardCc
          rewardToken     = rewardToken
          rewardCode      = rewardCode
          claimFeeCc      = claimFeeCc
          feePaid         = False
          feeTxId         = None
          rewardSent      = False
          rewardTxId      = None
          status          = "PRE_SETTLE"
          claimedAt       = drawnAt
        pure (newCampaignCid, newClaimCid)

    -- ── STATE MACHINE CHOICES ─────────────────────────────────
    -- Consuming (auto-archive) + create baru. Status Text match backend.
    choice Activate : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Transisi tidak sah! Hanya DRAFT/PAUSED → ACTIVE."
          (status == "DRAFT" || status == "PAUSED")
        assertMsg "updatedAt tidak boleh kosong!" (updatedAt /= "")
        create this with
          status = "ACTIVE"

    choice Pause : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Campaign harus ACTIVE untuk pause!" (status == "ACTIVE")
        assertMsg "updatedAt tidak boleh kosong!" (updatedAt /= "")
        create this with
          status = "PAUSED"

    choice EndCampaign : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Campaign harus ACTIVE untuk end!" (status == "ACTIVE")
        assertMsg "updatedAt tidak boleh kosong!" (updatedAt /= "")
        create this with
          status = "ENDED"

    -- CLOSED = consuming (archive, final state). Tidak bisa reopen.
    -- Archive event = on-chain finality record (Canton AI Q6 konfirmasi).
    consuming choice Close : ()
      with closedAt : Text
      controller admin
      do
        assertMsg "closedAt tidak boleh kosong!" (closedAt /= "")
        assertMsg "Hanya ACTIVE/ENDED → CLOSED." (status == "ACTIVE" || status == "ENDED")
        return ()


-- ============================================================
-- 3. TEMPLATE QUEST CLAIM RECEIPT
--    Receipt klaim + ATOMIC Settle.
--    Match backend: QuestLedgerService (claimFcfsSlot/drawRaffleWinner/
--      atomicFeeAndReward/revealRewardCode) — choice names baru v22.
--
--    Lifecycle:
--      "PRE_SETTLE" (slot reserved)
--        → [Settle] → "SETTLED"
--        → [RevealCode] → "REVEALED"
--      "PRE_SETTLE" → [Expire] → archived
--
--    Settle = nested CIP-56 (atomic all-or-nothing).
--    Tx ID diisi post-settle via RecordTxId (tx ID tidak bisa didapat
--    dari dalam choice — return TransferInstructionResult record).
-- ============================================================

template QuestClaimReceipt
  with
    admin           : Party
    campaignId      : Text
    userAddress     : Party
    claimId         : Text
    claimKind       : Text          -- questKind saat klaim
    rewardCc        : Decimal
    rewardToken     : Optional Text -- None|"CC" = Amulet; "USDCx" = token non-CC
    rewardCode      : Text          -- "" sampai RevealCode
    claimFeeCc      : Decimal
    feePaid         : Bool
    feeTxId         : Optional Text
    rewardSent      : Bool
    rewardTxId      : Optional Text
    status          : Text          -- "PRE_SETTLE"|"SETTLED"|"REVEALED"
    claimedAt       : Text
  where
    signatory admin
    observer userAddress

    -- Idempotency: 1 receipt aktif per (admin, campaignId, userAddress).
    -- Backend cek via lookupByKey sebelum ClaimSlot/DrawWinner.
    key (admin, campaignId, userAddress) : (Party, Text, Party)
    maintainer key._1

    -- ── ATOMIC SETTLE ──────────────────────────────────────────
    -- Nested exercise TransferFactory_Transfer (fee + reward) + optional
    -- FAR marker. Semua dalam 1 transaction tree → atomic.
    --
    -- Consuming (auto-archive) + create SETTLED. Nested exercise inherit
    -- authorization dari command-level actAs (Canton M3 auth model).
    --
    -- Backend submit dgn:
    --   actAs = [admin, userAddress, rewardParty] (+ appProvider bila FAR on)
    -- Pre-step backend (sebelum submit Settle):
    --   1. callTransferFactoryRegistry → feeChoiceContext, feeFactoryCid
    --   2. callTransferFactoryRegistry → rewardChoiceContext, rewardFactoryCid
    --      (rewardToken None|"CC" → instrumentId "Amulet"; "USDCx" → "USDCx")
    --   3. queryAmuletHoldings/getTokenHoldingCids → inputHoldingCids
    --   4. (optional) getFeaturedAppRightCid → farCid
    --   Lalu konstruksi Settle args dgn data di atas.
    --
    -- FAR MARKER DI-COMMENT SEMENTARA:
    -- DAR splice-api-featured-app belum didapat dari bundle (nama tidak match).
    -- Build bisa jalan tanpa FAR. Aktifkan kembali setelah DAR FAR tersedia.
    -- Saat aktif: choice butuh param featuredAppRightCid : Optional (ContractId FeaturedAppRight)
    -- dan appProvider : Party. Backend kirim None bila FAR off.
    choice Settle : ContractId QuestClaimReceipt
      with
        -- Fee leg: user → treasury
        feeFactoryCid    : ContractId TransferFactory
        feeTransfer      : Transfer
        feeExtraArgs     : ExtraArgs
        -- Reward leg: rewardParty → user
        rewardFactoryCid : ContractId TransferFactory
        rewardTransfer   : Transfer
        rewardExtraArgs  : ExtraArgs
        -- TODO FAR: uncomment setelah DAR splice-api-featured-app tersedia
        -- featuredAppRightCid : Optional (ContractId FeaturedAppRight)
        -- appProvider         : Party
        settledAt        : Text
      controller admin
      do
        -- Guard
        assertMsg "Claim harus PRE_SETTLE!" (status == "PRE_SETTLE")
        assertMsg "Fee atau reward harus > 0 untuk Settle!"
          (claimFeeCc > 0.0 || rewardCc > 0.0)

        -- 1. FEE transfer (atomic leg 1)
        --    Controller = feeTransfer.sender (user) → di-cover actAs command.
        _feeResult <- exercise feeFactoryCid TransferFactory_Transfer with
          expectedAdmin = feeTransfer.instrumentId.admin
          transfer      = feeTransfer
          extraArgs     = feeExtraArgs

        -- 2. REWARD transfer (atomic leg 2)
        --    Controller = rewardTransfer.sender (rewardParty) → di-cover actAs.
        --    rewardToken None|"CC" → transfer.instrumentId.id = "Amulet"
        --    rewardToken "USDCx"   → transfer.instrumentId.id = "USDCx"
        --    (Backend konstruksi transfer spec sesuai rewardToken.)
        _rewardResult <- exercise rewardFactoryCid TransferFactory_Transfer with
          expectedAdmin = rewardTransfer.instrumentId.admin
          transfer      = rewardTransfer
          extraArgs     = rewardExtraArgs

        -- TODO FAR: uncomment setelah DAR splice-api-featured-app tersedia.
        -- Controller = appProvider → backend actAs tambah appProvider.
        -- AppRewardBeneficiary.weight REQUIRED (Decimal 0.0-1.0).
        -- forA_ featuredAppRightCid $ \farCid ->
        --   exercise farCid FeaturedAppRight_CreateActivityMarker with
        --     beneficiaries = [ AppRewardBeneficiary with
        --       beneficiary = appProvider
        --       weight      = 1.0
        --     ]
        --     weight = None

        -- Consuming: auto-archive PRE_SETTLED, create SETTLED (tanpa txId — post-settle).
        create this with
          feePaid    = True
          rewardSent = True
          status     = "SETTLED"

    -- ── POST-SETTLE: Record tx IDs ─────────────────────────────
    -- Tx ID tidak bisa didapat dari dalam Settle (TransferFactory_Transfer
    -- return record, bukan tx id). Backend baca tx id dari Ledger API
    -- response setelah atomic command sukses, lalu exercise RecordTxId.
    choice RecordTxId : ContractId QuestClaimReceipt
      with
        feeTxId    : Text
        rewardTxId : Text
      controller admin
      do
        assertMsg "Claim harus SETTLED sebelum record tx id!" (status == "SETTLED")
        assertMsg "feeTxId tidak boleh kosong!" (feeTxId /= "")
        assertMsg "rewardTxId tidak boleh kosong!" (rewardTxId /= "")
        create this with
          feeTxId    = Some feeTxId
          rewardTxId = Some rewardTxId

    -- ── REVEAL CODE (CODE_FCFS / CODE_RAFFLE / CC_AND_CODE_RAFFLE) ──
    -- Reveal kode invite SETELAH fee dibayar.
    -- Match backend revealRewardCode() — argumen { code, revealedAt } PERSIS.
    choice RevealCode : ContractId QuestClaimReceipt
      with
        code       : Text
        revealedAt : Text
      controller admin
      do
        assertMsg "Fee harus dibayar dulu sebelum reveal kode!"
          (feePaid || claimFeeCc == 0.0)
        assertMsg "Kode tidak boleh kosong!" (code /= "")
        assertMsg "revealedAt tidak boleh kosong!" (revealedAt /= "")
        create this with
          rewardCode = code
          status     = "REVEALED"

    -- ── EXPIRE (cleanup slot yang tidak di-settle) ─────────────
    -- Untuk slot yang sudah reserved tapi user tidak bayar fee dalam
    -- waktu tertentu. Backend scheduler jalankan ini.
    consuming choice Expire : ()
      with expiredAt : Text
      controller admin
      do
        assertMsg "Hanya PRE_SETTLE yang bisa expire!" (status == "PRE_SETTLE")
        assertMsg "expiredAt tidak boleh kosong!" (expiredAt /= "")
        return ()
