-- ============================================================
-- CanQuest DAML Contract v25 — module Main
-- Package: canquest-v25 | SDK: 3.4.11
--
-- Templates:
--   1. WalletRegistration — identitas on-chain (Party ID)
--   2. CampaignEligibility — bukti lock CC / points per campaign (NEW v25)
--   3. QuestCampaign — kuota FCFS/Raffle + state machine + eligibility guard
--   4. QuestClaimReceipt — receipt + atomic settle quest reward (multi-controller)
--   5. PlatformTransfer — send token + platform fee atomic (NEW v25)
--
-- CHANGE v24 → v25:
--   - NEW template CampaignEligibility (eligibility proof: LOCK_CC / POINTS)
--   - NEW template PlatformTransfer (atomic send + fee)
--   - QuestCampaign: +field eligibilityType, eligibilityAmount
--   - ClaimSlot/DrawWinner: +param eligibilityCid + fetch guard
--   - QuestClaimReceipt.RecordTxId: rewardTxId jadi Optional Text (kode claim null)
--
-- DAML BOUNDARY (Layer 2):
--   ✅ Anti-sybil kuota FCFS/Raffle (atomic on-chain)
--   ✅ State machine campaign
--   ✅ Eligibility: lock CC harus SETELAH campaign dibuat (guard on-chain)
--   ✅ Eligibility: points minimum per campaign (guard on-chain)
--   ✅ Atomic settle (fee + reward + FAR dalam 1 tx tree)
--   ✅ Send token + platform fee atomic (2 output, 1 tx)
--   ✅ Multi-controller (DAML auth propagate ke nested exercise)
--   ✅ Multi-token: CC, USDCx, token lain via instrumentId
--
-- DAML TIDAK urus (pure CIP-56 / DAR Splice bawaan):
--   - Actual lock CC → AmuletRules_Transfer + LockedAmulet
--   - Send CC P2P (non-platform) → TransferFactory_Transfer
--   - Preapproval → AmuletRules_CreateTransferPreapproval
--
-- FAR Party: app-canquest::... (BUKAN validator party). appProvider param choice.
-- Di-exercise di Settle + ExecuteTransfer setiap transaksi ekonomi (bila FAR on).
--
-- actAs backend:
--   Quest Settle : [admin, userAddress, rewardSender] (+ appProvider bila FAR on)
--   PlatformTransfer : [admin, userAddress] (+ appProvider bila FAR on)
--   Lainnya : [admin]
-- ============================================================

module Main where

import DA.Foldable (forA_)
import Splice.Api.Token.TransferInstructionV1
  ( TransferFactory(..)
  , TransferFactory_Transfer(..)
  , Transfer(..)
  )
import Splice.Api.Token.MetadataV1 (ExtraArgs(..))
import Splice.Api.FeaturedAppRightV2
  ( FeaturedAppRight(..)
  , FeaturedAppRight_CreateActivityMarker(..)
  , AppRewardBeneficiary(..)
  )


-- ============================================================
-- 1. WALLET REGISTRATION
--    Fungsi: Jangkar identitas user on-chain saat register wallet.
--    - Satu contract per user (idempotency backend-enforced)
--    - Admin sebagai signatory, user sebagai observer
--    - Tidak ada choice — create-only, immutable
--    Match backend: QuestLedgerService.registerWallet()
-- ============================================================

template WalletRegistration
  with
    admin         : Party
    userAddress   : Party
    username      : Text
    partyId       : Text
    inviteCode    : Text
    registeredAt  : Text
  where
    signatory admin
    observer userAddress


-- ============================================================
-- 2. CAMPAIGN ELIGIBILITY (NEW v25)
--    Fungsi: Bukti on-chain bahwa user memenuhi syarat eligibility
--    untuk campaign tertentu.
--
--    2 tipe eligibility:
--      "LOCK_CC" — user harus lock CC >= amount
--                  DAN lock dilakukan SETELAH campaign dibuat
--      "POINTS"  — user harus punya points >= amount
--                  (points di-verify backend sebelum create eligibility)
--
--    Lifecycle:
--      ELIGIBLE → [RevokeEligibility] → archived (lock dibuka sebelum campaign selesai)
--      ELIGIBLE → [ExpireEligibility] → archived (campaign selesai)
--
--    Dibuat oleh backend SETELAH verifikasi:
--      LOCK_CC: AllocationFactory/AmuletRules lock sukses + lockedAt > campaignCreatedAt
--      POINTS : PointsService.getNetPoints(userId) >= amount
--
--    Signatory admin → ClaimSlot/DrawWinner bisa fetch contract ini.
-- ============================================================

template CampaignEligibility
  with
    admin              : Party
    userAddress        : Party
    campaignId         : Text
    campaignCreatedAt  : Text          -- timestamp campaign dibuat (utk validasi lock)
    eligibilityType    : Text          -- "LOCK_CC" | "POINTS"
    amount             : Decimal       -- jumlah CC locked atau points
    lockedAt           : Text          -- kapan user lock CC (kosong bila POINTS)
    expiresAt          : Text          -- eligibility berlaku sampai kapan
    status             : Text          -- "ELIGIBLE" | "REVOKED" | "EXPIRED"
  where
    signatory admin
    observer userAddress

    -- Revoke: bila user unlock CC sebelum campaign selesai.
    -- Backend monitor unlock event → exercise RevokeEligibility.
    choice RevokeEligibility : ()
      with revokedAt : Text
      controller admin
      do
        assertMsg "Harus ELIGIBLE untuk revoke!" (status == "ELIGIBLE")
        assertMsg "revokedAt tidak boleh kosong!" (revokedAt /= "")
        return ()

    -- Expire: cleanup setelah campaign CLOSED/ENDED.
    choice ExpireEligibility : ()
      with expiredAt : Text
      controller admin
      do
        assertMsg "Harus ELIGIBLE untuk expire!" (status == "ELIGIBLE")
        assertMsg "expiredAt tidak boleh kosong!" (expiredAt /= "")
        return ()


-- ============================================================
-- 3. QUEST CAMPAIGN
--    Fungsi: Manajemen campaign quest dengan kuota atomic on-chain.
--
--    Fitur:
--    - State machine: DRAFT→ACTIVE→PAUSED→ENDED→CLOSED
--    - FCFS: klaim slot atomic, anti-sybil (concurrent conflict → abort)
--    - Raffle/Waitlist: admin draw pemenang
--    - Eligibility guard: lock CC atau points per campaign (v25 NEW)
--    - Multi-token reward: CC, USDCx, token lain
--
--    Eligibility config per campaign:
--      eligibilityType = "NONE"    → siapa saja bisa klaim
--      eligibilityType = "LOCK_CC" → wajib lock CC >= eligibilityAmount,
--                                     lock harus SETELAH campaign dibuat
--      eligibilityType = "POINTS"  → wajib punya points >= eligibilityAmount
--
--    Match backend: QuestLedgerService.createQuestCampaign()
--    Field match backend createContract args + eligibility (v25).
-- ============================================================

template QuestCampaign
  with
    admin              : Party
    campaignId         : Text
    title              : Text
    questKind          : Text          -- CC_FCFS|CC_RAFFLE|CODE_FCFS|CODE_RAFFLE|CC_AND_CODE_RAFFLE|WAITLIST
    rewardCc           : Decimal
    rewardToken        : Optional Text -- None|"CC" = Amulet; "USDCx" = token non-CC
    claimFeeCc         : Decimal
    maxWinners         : Int           -- 0 = unlimited
    currentClaims      : Int
    status             : Text          -- "DRAFT"|"ACTIVE"|"PAUSED"|"ENDED"|"CLOSED"
    eligibilityType    : Text          -- "NONE"|"LOCK_CC"|"POINTS" (v25 NEW)
    eligibilityAmount  : Decimal       -- min CC locked atau min points (0.0 bila NONE)
    createdAt          : Text
  where
    signatory admin

    -- ── FCFS CLAIM ───────────────────────────────────────────
    -- User klaim slot FCFS secara atomic.
    -- Consuming: auto-archive, concurrent claim → ledger conflict → abort.
    -- Guard eligibility: fetch CampaignEligibility on-chain (bila type != NONE).
    -- Guard lock timestamp: lockedAt HARUS > campaignCreatedAt (LOCK_CC).
    -- Match backend: QuestLedgerService.claimFcfsSlot().
    -- Argumen match backend PERSIS: { user, claimId, claimedAt, rewardSender, eligibilityCid }
    choice ClaimSlot : (ContractId QuestCampaign, ContractId QuestClaimReceipt)
      with
        user           : Party
        claimId        : Text
        claimedAt      : Text
        rewardSender   : Party       -- v24: party reward wallet (co-controller Settle)
        eligibilityCid : Optional (ContractId CampaignEligibility)  -- v25 NEW
      controller admin
      do
        assertMsg "Campaign harus ACTIVE!" (status == "ACTIVE")
        assertMsg "questKind harus FCFS!"
          (questKind == "CC_FCFS" || questKind == "CODE_FCFS")
        assertMsg "Kuota FCFS sudah habis!"
          (maxWinners == 0 || currentClaims < maxWinners)

        -- Guard eligibility (v25)
        case eligibilityType of
          "LOCK_CC" -> case eligibilityCid of
            None -> assertMsg "User harus lock CC dulu!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!"
                (e.status == "ELIGIBLE")
              assertMsg "Jumlah lock CC kurang dari minimum!"
                (e.amount >= eligibilityAmount)
              -- KUNCI: lock harus SETELAH campaign dibuat
              assertMsg "Lock CC harus dilakukan setelah campaign dibuat!"
                (e.lockedAt > e.campaignCreatedAt)
          "POINTS" -> case eligibilityCid of
            None -> assertMsg "User harus punya points cukup!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!"
                (e.status == "ELIGIBLE")
              assertMsg "Points kurang dari minimum!"
                (e.amount >= eligibilityAmount)
          _ -> pure ()  -- "NONE": tidak perlu eligibility

        newCampaignCid <- create this with
          currentClaims = currentClaims + 1
        newClaimCid <- create QuestClaimReceipt with
          admin           = admin
          campaignId      = campaignId
          userAddress     = user
          claimId         = claimId
          claimKind       = questKind
          rewardCc        = rewardCc
          rewardToken     = rewardToken
          rewardCode      = ""
          rewardSender    = rewardSender
          claimFeeCc      = claimFeeCc
          feePaid         = False
          feeTxId         = None
          rewardSent      = False
          rewardTxId      = None
          status          = "PRE_SETTLE"
          claimedAt       = claimedAt
        pure (newCampaignCid, newClaimCid)

    -- ── RAFFLE / WAITLIST DRAW ────────────────────────────────
    -- Admin draw pemenang raffle/waitlist.
    -- Hanya admin yang bisa exercise (user tidak bisa self-draw).
    -- Guard eligibility sama dengan ClaimSlot.
    -- Match backend: QuestLedgerService.drawRaffleWinner().
    -- Argumen match backend PERSIS: { user, claimId, rewardCode, drawnAt, rewardSender, eligibilityCid }
    choice DrawWinner : (ContractId QuestCampaign, ContractId QuestClaimReceipt)
      with
        user           : Party
        claimId        : Text
        rewardCode     : Text          -- bisa "" (CC) atau kode invite
        drawnAt        : Text
        rewardSender   : Party         -- v24: co-controller Settle
        eligibilityCid : Optional (ContractId CampaignEligibility)  -- v25 NEW
      controller admin
      do
        assertMsg "Campaign harus ACTIVE!" (status == "ACTIVE")
        assertMsg "Kuota raffle sudah habis!"
          (maxWinners == 0 || currentClaims < maxWinners)
        assertMsg "questKind harus RAFFLE/WAITLIST!"
          ( questKind == "CC_RAFFLE"
         || questKind == "CODE_RAFFLE"
         || questKind == "CC_AND_CODE_RAFFLE"
         || questKind == "WAITLIST" )

        -- Guard eligibility (sama dengan ClaimSlot)
        case eligibilityType of
          "LOCK_CC" -> case eligibilityCid of
            None -> assertMsg "User harus lock CC dulu!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!"
                (e.status == "ELIGIBLE")
              assertMsg "Jumlah lock CC kurang dari minimum!"
                (e.amount >= eligibilityAmount)
              assertMsg "Lock CC harus dilakukan setelah campaign dibuat!"
                (e.lockedAt > e.campaignCreatedAt)
          "POINTS" -> case eligibilityCid of
            None -> assertMsg "User harus punya points cukup!" False
            Some eCid -> do
              e <- fetch eCid
              assertMsg "Eligibility bukan untuk campaign ini!"
                (e.campaignId == campaignId)
              assertMsg "Eligibility tidak valid!"
                (e.status == "ELIGIBLE")
              assertMsg "Points kurang dari minimum!"
                (e.amount >= eligibilityAmount)
          _ -> pure ()

        newCampaignCid <- create this with
          currentClaims = currentClaims + 1
        newClaimCid <- create QuestClaimReceipt with
          admin           = admin
          campaignId      = campaignId
          userAddress     = user
          claimId         = claimId
          claimKind       = questKind
          rewardCc        = rewardCc
          rewardToken     = rewardToken
          rewardCode      = rewardCode
          rewardSender    = rewardSender
          claimFeeCc      = claimFeeCc
          feePaid         = False
          feeTxId         = None
          rewardSent      = False
          rewardTxId      = None
          status          = "PRE_SETTLE"
          claimedAt       = drawnAt
        pure (newCampaignCid, newClaimCid)

    -- ── STATE MACHINE ─────────────────────────────────────────
    -- Consuming (auto-archive) + create baru. Status Text match backend.
    choice Activate : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Hanya DRAFT/PAUSED → ACTIVE."
          (status == "DRAFT" || status == "PAUSED")
        assertMsg "updatedAt tidak boleh kosong!" (updatedAt /= "")
        create this with
          status = "ACTIVE"

    choice Pause : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Campaign harus ACTIVE untuk pause!" (status == "ACTIVE")
        assertMsg "updatedAt tidak boleh kosong!" (updatedAt /= "")
        create this with
          status = "PAUSED"

    choice EndCampaign : ContractId QuestCampaign
      with updatedAt : Text
      controller admin
      do
        assertMsg "Campaign harus ACTIVE untuk end!" (status == "ACTIVE")
        assertMsg "updatedAt tidak boleh kosong!" (updatedAt /= "")
        create this with
          status = "ENDED"

    -- CLOSED = consuming (archive, final state). Tidak bisa reopen.
    choice Close : ()
      with closedAt : Text
      controller admin
      do
        assertMsg "closedAt tidak boleh kosong!" (closedAt /= "")
        assertMsg "Hanya ACTIVE/ENDED → CLOSED."
          (status == "ACTIVE" || status == "ENDED")
        return ()


-- ============================================================
-- 4. QUEST CLAIM RECEIPT
--    Fungsi: Receipt klaim + atomic settle (fee + reward + FAR).
--
--    Lifecycle:
--      "PRE_SETTLE" → [Settle] → "SETTLED"
--                   → [RevealCode] → "REVEALED"
--                   → [RecordTxId] → "SETTLED" (update tx IDs)
--      "PRE_SETTLE" → [Expire] → archived
--
--    Atomic settle (1 transaction tree, all-or-nothing):
--      Leg 1: Fee (user → treasury)
--      Leg 2: Reward (rewardSender → user) — optional, skip bila kode claim
--      Leg 3: FAR marker → CC reward ke appProvider
--
--    Multi-controller (v24 fix): admin + userAddress + rewardSender wajib
--    co-controller Settle agar nested TransferFactory_Transfer (controller=
--    transfer.sender) ter-authorize. FAR leg controller=appProvider skip saat
--    featuredAppRightCid=None.
--
--    Match backend: QuestLedgerService.settleAtomic() + recordTxId().
-- ============================================================

template QuestClaimReceipt
  with
    admin           : Party
    campaignId      : Text
    userAddress     : Party
    claimId         : Text
    claimKind       : Text
    rewardCc        : Decimal
    rewardToken     : Optional Text -- None|"CC" = Amulet; "USDCx" = token non-CC
    rewardCode      : Text          -- "" sampai RevealCode
    rewardSender    : Party         -- v24: party reward wallet (co-controller Settle)
    claimFeeCc      : Decimal
    feePaid         : Bool
    feeTxId         : Optional Text
    rewardSent      : Bool
    rewardTxId      : Optional Text
    status          : Text          -- "PRE_SETTLE"|"SETTLED"|"REVEALED"
    claimedAt       : Text
  where
    signatory admin
    observer userAddress

    -- ── ATOMIC SETTLE ─────────────────────────────────────────
    -- Bayar fee + kirim reward + FAR marker dalam 1 tx tree.
    -- Multi-controller wajib (v24): admin + userAddress + rewardSender.
    -- Nested TransferFactory_Transfer controller = transfer.sender:
    --   fee leg  → controller = feeTransfer.sender = user
    --   reward leg → controller = rewardTransfer.sender = rewardSender
    -- Tanpa co-controller, DAML_AUTHORIZATION_ERROR (nested auth tidak propagate).
    -- FAR leg controller = appProvider → skip saat featuredAppRightCid=None.
    choice Settle : ContractId QuestClaimReceipt
      with
        feeFactoryCid       : ContractId TransferFactory
        feeTransfer         : Transfer
        feeExtraArgs        : ExtraArgs
        rewardFactoryCid    : Optional (ContractId TransferFactory)
        rewardTransfer      : Optional Transfer
        rewardExtraArgs     : Optional ExtraArgs
        featuredAppRightCid : Optional (ContractId FeaturedAppRight)
        appProvider         : Party            -- CANTON_APP_PROVIDER_PARTY_ID
        settledAt           : Text
      controller admin, userAddress, rewardSender
      do
        assertMsg "Claim harus PRE_SETTLE!" (status == "PRE_SETTLE")
        assertMsg "Fee harus > 0 untuk Settle!" (claimFeeCc > 0.0)
        assertMsg "settledAt tidak boleh kosong!" (settledAt /= "")

        -- Leg 1: Fee (user → treasury)
        _feeResult <- exercise feeFactoryCid TransferFactory_Transfer with
          expectedAdmin = feeTransfer.instrumentId.admin
          transfer      = feeTransfer
          extraArgs     = feeExtraArgs

        -- Leg 2: Reward (rewardSender → user), skip bila kode claim (reward=None)
        rewardActuallySent <- case rewardFactoryCid of
          None -> pure False
          Some rfd -> case rewardTransfer of
            None -> pure False
            Some rt -> case rewardExtraArgs of
              None -> pure False
              Some rea -> do
                _ <- exercise rfd TransferFactory_Transfer with
                  expectedAdmin = rt.instrumentId.admin
                  transfer      = rt
                  extraArgs     = rea
                pure True

        -- Leg 3: FAR marker (optional - hanya bila Some).
        -- Controller = appProvider → backend actAs tambah appProvider bila FAR on.
        forA_ featuredAppRightCid $ \farCid -> do
          exercise farCid FeaturedAppRight_CreateActivityMarker with
            beneficiaries = [ AppRewardBeneficiary
              { beneficiary = appProvider
              , weight      = 1.0
              } ]
            weight = None

        create this with
          feePaid    = True
          rewardSent = rewardActuallySent
          status     = "SETTLED"

    -- ── POST-SETTLE: Record tx IDs ────────────────────────────
    -- Tx ID tidak bisa didapat dari dalam Settle (TransferFactory_Transfer
    -- return record, bukan tx id). Backend baca tx id dari Ledger API
    -- response setelah atomic command sukses, lalu exercise RecordTxId.
    -- v25: rewardTxId jadi Optional Text (kode claim reward=0 → null).
    choice RecordTxId : ContractId QuestClaimReceipt
      with
        feeTxId    : Text
        rewardTxId : Optional Text
      controller admin
      do
        assertMsg "Claim harus SETTLED sebelum record tx id!" (status == "SETTLED")
        assertMsg "feeTxId tidak boleh kosong!" (feeTxId /= "")
        create this with
          feeTxId    = Some feeTxId
          rewardTxId = rewardTxId

    -- ── REVEAL CODE (CODE_FCFS / CODE_RAFFLE / CC_AND_CODE_RAFFLE) ──
    -- Reveal kode invite SETELAH fee dibayar.
    -- Match backend revealRewardCode() — argumen { code, revealedAt } PERSIS.
    choice RevealCode : ContractId QuestClaimReceipt
      with
        code       : Text
        revealedAt : Text
      controller admin
      do
        assertMsg "Fee harus dibayar dulu sebelum reveal kode!"
          (feePaid || claimFeeCc == 0.0)
        assertMsg "Kode tidak boleh kosong!" (code /= "")
        assertMsg "revealedAt tidak boleh kosong!" (revealedAt /= "")
        create this with
          rewardCode = code
          status     = "REVEALED"

    -- ── EXPIRE (cleanup slot yang tidak di-settle) ────────────
    -- Untuk slot yang sudah reserved tapi user tidak bayar fee dalam
    -- waktu tertentu. Backend scheduler jalankan ini.
    -- Consuming (default) = archive, final.
    choice Expire : ()
      with expiredAt : Text
      controller admin
      do
        assertMsg "Hanya PRE_SETTLE yang bisa expire!" (status == "PRE_SETTLE")
        assertMsg "expiredAt tidak boleh kosong!" (expiredAt /= "")
        return ()


-- ============================================================
-- 5. PLATFORM TRANSFER (NEW v25)
--    Fungsi: Send token ke receiver + platform fee atomic.
--    1 transaction tree = 3 leg all-or-nothing:
--      Leg 1: user → receiver (transfer token utama)
--      Leg 2: user → treasury (platform fee)
--      Leg 3: FAR marker → CC reward ke appProvider (bila FAR on)
--
--    Multi-token: CC, USDCx, token lain via instrumentId.
--    Multi-controller: admin + userAddress (kedua leg controller = user).
--    actAs backend: [admin, userAddress] (+ appProvider bila FAR on)
--
--    Replaces: sendCc/sendToken path lama (2 transfer terpisah non-atomic).
--    Backend feature flag QUEST_ATOMIC_PLATFORM_TRANSFER utk gradual rollout.
-- ============================================================

template PlatformTransfer
  with
    admin       : Party
    userAddress : Party
    transferId  : Text
    amount      : Decimal
    feeAmount   : Decimal
    receiver    : Party
    treasury    : Party
    token       : Text          -- "CC" | "USDCx" | token lain
    status      : Text          -- "PENDING" | "SETTLED"
    createdAt   : Text
  where
    signatory admin
    observer userAddress

    -- ATOMIC: transfer + fee + FAR dalam 1 transaction tree.
    -- Controller admin + userAddress (kedua leg sender = user).
    choice ExecuteTransfer : ContractId PlatformTransfer
      with
        transferFactoryCid   : ContractId TransferFactory
        transferSpec         : Transfer
        transferExtraArgs    : ExtraArgs
        feeFactoryCid        : ContractId TransferFactory
        feeSpec              : Transfer
        feeExtraArgs         : ExtraArgs
        featuredAppRightCid  : Optional (ContractId FeaturedAppRight)
        appProvider          : Party
        settledAt            : Text
      controller admin, userAddress
      do
        assertMsg "Status harus PENDING!" (status == "PENDING")
        assertMsg "Amount harus > 0!" (amount > 0.0)
        assertMsg "Fee harus > 0!" (feeAmount > 0.0)
        assertMsg "settledAt tidak boleh kosong!" (settledAt /= "")

        -- Leg 1: Transfer utama ke receiver
        _ <- exercise transferFactoryCid TransferFactory_Transfer with
          expectedAdmin = transferSpec.instrumentId.admin
          transfer      = transferSpec
          extraArgs     = transferExtraArgs

        -- Leg 2: Platform fee ke treasury
        _ <- exercise feeFactoryCid TransferFactory_Transfer with
          expectedAdmin = feeSpec.instrumentId.admin
          transfer      = feeSpec
          extraArgs     = feeExtraArgs

        -- Leg 3: FAR marker → CC reward ke appProvider (bila FAR on)
        forA_ featuredAppRightCid $ \farCid -> do
          exercise farCid FeaturedAppRight_CreateActivityMarker with
            beneficiaries = [ AppRewardBeneficiary
              { beneficiary = appProvider
              , weight      = 1.0
              } ]
            weight = None

        create this with
          status = "SETTLED"

    -- Cancel transfer yang belum settle
    choice CancelTransfer : ()
      with cancelledAt : Text
      controller admin
      do
        assertMsg "Hanya PENDING yang bisa dicancel!" (status == "PENDING")
        assertMsg "cancelledAt tidak boleh kosong!" (cancelledAt /= "")
        return ()
