generator client {
  provider = "prisma-client-js"
}

// PostgreSQL.
// Local dev:  `docker compose -f docker-compose.dev.yml up -d` (Postgres 16).
// Production: Postgres lokal di VPS 2 (localhost:5432, tanpa pooler).
//   - DATABASE_URL: app runtime (driver adapter-pg).
//   - DIRECT_URL:   prisma migrate deploy (di VPS 2 = sama dengan DATABASE_URL).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Application state: auth, quests, earn entries, etc.
model User {
  id                        String                 @id @default(cuid())
  email                     String                 @unique
  displayName               String?
  /// Relative path under uploads root, e.g. avatars/{userId}.jpg
  avatarPath                String?
  passwordHash              String
  inviteCode                String?
  /// Unique code this user shares for friend referrals (e.g. CQ8X4K2M).
  referralCode              String?                @unique
  /// Set when the user registered with someone else's referralCode.
  referredById              String?
  referredBy                User?                  @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers             User[]                 @relation("UserReferrals")
  emailVerified             Boolean                @default(false)
  otpCodeHash               String?
  otpExpiresAt              DateTime?
  /// Failed OTP verification attempts for the current pending code. Reset to 0 on each new code; >=5 clears the OTP.
  otpAttempts               Int                    @default(0)
  username                  String?                @unique
  /// Canton ledger party identifier after binding — follow Participant / Ledger API contracts.
  /// SECURITY (H6): @unique enforces 1 wallet ↔ 1 account at the DB level. Without
  /// this, a single Canton wallet could be bound to many accounts, letting one
  /// attacker claim quest rewards / FCFS slots / raffle entries N times via N
  /// email accounts sharing one funded wallet. The app-layer findByPartyId check
  /// in party.controller is a TOCTOU guard; this constraint is the source of truth.
  cantonPartyId             String?                @unique
  /// Model custody wallet: null = belum ada wallet, "custodial" = party lama di
  /// namespace validator (kunci server), "external" = non-custodial (kunci Ed25519
  /// di browser user; tanda tangan transaksi wajib dari user — terverifikasi M0).
  walletKind                String?
  /// Kapan user menyelesaikan verifikasi backup kunci (key ceremony: ketik ulang
  /// karakter raw hex). Wajib terisi untuk walletKind "external".
  backupVerifiedAt          DateTime?
  /// M4: party custodial lama sebelum upgrade ke non-custodial (audit trail;
  /// party lama dibiarkan kosong di chain). Null = belum pernah upgrade.
  legacyPartyId             String?
  /// Keycloak user UUID (sub) — identity bridge between web2 User and on-chain Ledger API user.
  keycloakId                String?                @unique
  /// Last time user toggled preapproval (enable/disable). Cooldown 7 hari anti-spam burn.
  preapprovalToggleAt       DateTime?
  /// Admin flag — set via ADMIN_EMAILS env or manually.
  isAdmin                   Boolean                @default(false)
  /// Account access status (ACTIVE = full access). Additive — defaults ACTIVE so existing users are unaffected.
  status                    UserStatus             @default(ACTIVE)
  /// Timestamp of the most recent ban/suspend (null when ACTIVE).
  bannedAt                  DateTime?
  /// Admin-supplied reason for the current ban/suspend (null when ACTIVE).
  banReason                 String?
  /// Lifetime earn points (quest/earn tasks, completion bonus, referral) — synced via PointsService.
  earnPoints                Int                    @default(0)
  /// Linked X (Twitter) handle for social task verification (twitterapi.io).
  twitterUsername           String?                @unique
  /// M4b: backup kunci dompet terenkripsi (sync antar-browser, opt-out-able).
  /// Blob = AES-256-GCM atas seed Ed25519; kunci derive dari PASSPHRASE user
  /// (PBKDF2 310k). Server TIDAK pernah punya passphrase — dekripsi 100% client.
  walletKeyBackup           WalletKeyBackup?
  twitterUserId             String?
  /// High-res X avatar URL (pbs.twimg.com, _400x400) — not stored on VPS disk.
  twitterAvatarUrl          String?
  twitterConnectedAt        DateTime?
  /// Last time the user opened or dismissed in-app CC notifications (bell).
  notificationsLastSeenAt   DateTime?
  /// Email campaign notifications (new campaign / raffle winner / not selected).
  /// Target link "Manage email preferences" di footer email — dihormati semua
  /// query penerima email campaign.
  emailNotificationsEnabled Boolean                @default(true)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  refreshTokens             RefreshToken[]
  passwordResets            PasswordReset[]        @relation("UserPasswordResets")
  ccBalance                 CcBalance?
  ccTransactions            CcTransaction[]
  questCompletions          QuestCompletion[]
  questSubmissions          QuestSubmission[]
  winnerDraws               WinnerDraw[]
  assignedCodes             InviteCodePool[]
  referralRewardsGiven      ReferralReward[]       @relation("ReferralRewardsGiven")
  referralRewardReceived    ReferralReward?        @relation("ReferralRewardReceived")
  walletAllocations         WalletAllocationLog[]
  redeemedWalletInvites     WalletInviteCode[]     @relation("WalletInviteRedemptions")
  ccLocks                   CcLock[]
  /// v30: lock CC per-campaign (LockProposal→AcceptLock→LockedAmulet holders=[validator]).
  lockProposals             LockProposalRecord[]
  earnEntries               EarnEntry[]
  /// Off-chain custody: saldo token non-CC user di Cantex trading account shared.
  cantexTokenBalances       CantexTokenBalance[]
  /// Riwayat P2P transfer token non-CC on-chain (CIP-0056 two-step).
  tokenTransactions         TokenTransaction[]
  /// Riwayat swap CC ↔ token Cantex DEX.
  swapTransactions          SwapTransaction[]
  /// Delivery token/CC tertunda dari swap yang gagal di-deliver on-chain.
  /// OAuth / external identity links (Google, dst). 1 user bisa banyak provider.
  accounts                  Account[]
  /// Outbox email notifikasi campaign (Resend) — 1 baris = 1 email per (user, quest, type).
  emailNotificationLogs     EmailNotificationLog[]
  partnerLikes              PartnerLike[]
}

/// OAuth account link — binds a User to an external identity provider.
/// providerAccountId = provider's stable, immutable subject (e.g. Google `sub`),
/// BUKAN email. Email cuma snapshot untuk audit.
model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "google" | "apple" | dst.
  provider          String
  /// Stable immutable subject from provider (Google sub, Apple sub).
  providerAccountId String
  /// Snapshot email saat link (audit only — identity source-of-truth = sub).
  email             String
  linkedAt          DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Catatan partisipasi user di campaign Earn — sekaligus sumber pengurang poin
/// (menggantikan SpinResult sebagai satu-satunya tempat poin terpotong).
/// Satu baris per (user, quest): gate Earn berlaku per-campaign.
model EarnEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId       String
  /// Metode akses yang dipakai: 'points' | 'cc_lock' | 'none' (mode gate NONE / event gratis)
  method        String
  /// Poin terpotong (0 jika method = cc_lock)
  pointsSpent   Int      @default(0)
  /// CC yang dikunci/terpakai dalam micro-CC (0 jika method = points)
  ccLockedMicro BigInt   @default(0)
  /// true jika lock CC sudah dikembalikan (khusus jalur escrow cc_lock)
  released      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([userId, questId])
  @@index([questId])
}

/// M4b: backup kunci dompet terenkripsi — sync antar-browser (1 per user).
/// Blob = record terenkripsi dari browser (AES-256-GCM, PBKDF2 dari passphrase
/// user). Server hanya penyimpan; dekripsi & passphrase tidak pernah keluar
/// dari browser.
model WalletKeyBackup {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blob      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One-time codes required to create a Canton wallet (admin-generated).
/// Consumed only after a real wallet is created (redeemedAt set). Failed attempts release the reservation.
///
/// v30 hardening (AGENT.md): kode disimpan sebagai HASH sha256 (codeHash),
/// plaintext hanya tampil SEKALI saat generate. Kolom `code` dipertahankan
/// hanya sebagai masked display ('hashed-xxxxxxxx') — lookup/reserve/redeem
/// selalu lewat codeHash. Redeem = UPDATE bersyarat (WHERE codeHash AND
/// redeemedAt IS NULL) — race antar request kalah di DB, bukan di kode app.
model WalletInviteCode {
  id           String    @id @default(cuid())
  /// Masked display pasca-migrasi hash. Kode baru tidak pernah menyimpan plaintext di sini.
  code         String
  /// sha256(plaintext) hex — satu-satunya kunci lookup. Dibackfill dari `code`.
  codeHash     String    @unique
  note         String?
  createdAt    DateTime  @default(now())
  redeemedAt   DateTime?
  redeemedById String?
  redeemedBy   User?     @relation("WalletInviteRedemptions", fields: [redeemedById], references: [id], onDelete: SetNull)
  /// Temporary hold while user is creating a wallet (not consumed until success).
  reservedById String?
  reservedAt   DateTime?

  @@index([redeemedAt])
  @@index([reservedById])
  @@index([createdAt])
}

/// Global daily counter — each row is one Canton/Splice wallet slot consumed (UTC day).
model WalletAllocationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username  String?
  partyId   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

/// One row per successful referred signup (referrer credited once).
model ReferralReward {
  id             String   @id @default(cuid())
  referrerId     String
  referrer       User     @relation("ReferralRewardsGiven", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String   @unique
  referredUser   User     @relation("ReferralRewardReceived", fields: [referredUserId], references: [id], onDelete: Cascade)
  points         Int
  createdAt      DateTime @default(now())

  @@index([referrerId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

/// One-time 6-digit password reset codes (HMAC-SHA256 hashed) — separate from email OTP.
/// Anti-enumeration: forgot-password always replies generically; only stored when user exists.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserPasswordResets", fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // HMAC-SHA256(secret, `reset:${userId}:${code}`)
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Tracks CC token balance for each user (off-chain mirror of Canton ledger).
/// Settled to the actual Splice ledger periodically or on withdrawal.
model CcBalance {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Total CC balance in micro-CC (1 CC = 1_000_000 micro-CC) to avoid float precision issues.
  balanceMicroCc BigInt   @default(0)
  updatedAt      DateTime @updatedAt
}

/// Every CC credit/debit event — full audit trail.
model CcTransaction {
  id                     String            @id @default(cuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Positive = credit, negative = debit (in micro-CC).
  amountMicroCc          BigInt
  type                   CcTransactionType
  /// Human-readable description, e.g. "Quest reward: Daily Login"
  description            String
  /// Reference to the source (questId, earnEntryId, etc.)
  referenceId            String?
  /// Offer / contract ID on Canton (e.g. TransferOffer contract).
  ledgerTxId             String?
  /// Ledger update ID from submit-and-wait / transaction stream (CantonScan).
  cantonUpdateId         String?
  status                 String            @default("COMPLETED") // COMPLETED | PENDING | REJECTED
  transferInstructionCid String?
  settledAt              DateTime?
  createdAt              DateTime          @default(now())

  /// Jumlah asli (CC) yang dibatalkan/ditolak — hanya diisi untuk OFFER_WITHDRAWN /
  /// OFFER_REJECTED. Saldo tidak bergerak (amountMicroCc=0), tapi amount asli
  /// offer disimpan di sini agar Activity & badge bisa menampilkan "cancelled 5 CC".
  cancelledAmountCc     Decimal? @db.Decimal(20, 10)
  /// Instrument id token (mis. "USDCx") bila offer yang dibatalkan adalah token.
  cancelledInstrumentId String?

  @@unique([userId, ledgerTxId])
  @@index([cantonUpdateId])
  @@index([transferInstructionCid])
}

enum CcTransactionType {
  QUEST_REWARD
  SPIN_REWARD
  TRANSFER_IN
  TRANSFER_OUT
  AIRDROP
  CC_LOCK
  CC_UNLOCK
  /// Receiver menolak incoming TransferInstruction (onchain exercise).
  OFFER_REJECTED
  /// Sender menarik kembali TransferInstruction yang belum di-accept.
  OFFER_WITHDRAWN
  /// User mengaktifkan TransferPreapproval (onchain create, burn fee).
  PREAPPROVAL_ENABLED
  /// User menonaktifkan TransferPreapproval (onchain archive).
  PREAPPROVAL_DISABLED
  /// CC keluar dari party user menuju Cantex trading account (swap CC → token).
  SWAP_OUT
  /// CC masuk ke party user dari Cantex trading account (swap token → CC).
  SWAP_IN
}

/// Off-chain custody untuk token non-CC (Cantex DEX). Token asli berada di
/// Cantex trading account yang shared (cantex::1220c6...); CanQuest mencatat
/// kepemilikan per-user di sini (model custodial Wintip-style).
/// Saldo pakai Decimal(38,18) karena Cantex API memakai decimal-string amounts.
model CantexTokenBalance {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cantex instrument id, mis. "TokenX" / "Amulet".
  instrumentId    String
  /// Cantex instrument admin party, mis. "DSO::1220...".
  instrumentAdmin String
  /// Saldo human-decimal (bukan micro-units).
  balance         Decimal  @default(0) @db.Decimal(38, 18)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, instrumentId, instrumentAdmin])
  @@index([userId])
}

/// Riwayat P2P transfer token non-CC on-chain (CIP-0056 two-step).
/// CcTransaction strictly CC (amountMicroCc, no instrument field) — menumpang
/// amount token non-CC di situ akan corrupt audit trail & reconcile CC. Model
/// ini instrument-aware: amount pakai Decimal(38,18) sesuai Cantex API.
///
/// Sumber kebenaran saldo token = ON-CHAIN (queryTokenHoldings). CantexTokenBalance
/// (DB) jadi cache/UI-only — BUKAN dipakai untuk validate send-token.
model TokenTransaction {
  id                     String      @id @default(cuid())
  userId                 String
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cantex instrument id, mis. "USDCX", "TokenX". "Amulet" jika dipakai untuk CC.
  instrumentId           String
  /// Cantex instrument admin party, mis. "DSO::1220...".
  instrumentAdmin        String
  /// Jumlah token (positive = credit masuk, negatif = debit keluar). Decimal-string compatible.
  amount                 Decimal     @db.Decimal(38, 18)
  type                   TokenTxType
  description            String?
  /// Reference (counterparty party id, contract id, dsb).
  referenceId            String?
  /// Offer / contract ID on Canton (TransferInstruction contract id).
  ledgerTxId             String?
  /// Ledger update ID dari submit-and-wait (CantonScan link).
  cantonUpdateId         String?
  transferInstructionCid String?
  status                 String      @default("COMPLETED") // COMPLETED | PENDING | REJECTED
  createdAt              DateTime    @default(now())

  /// Jumlah asli (token) yang dibatalkan/ditarik — hanya diisi untuk
  /// TOKEN_OFFER_WITHDRAWN / TOKEN_OFFER_REJECTED. Saldo tidak bergerak (amount=0),
  /// tapi amount asli offer disimpan di sini agar Activity & badge bisa menampilkan
  /// "cancelled 5 USDCx".
  cancelledAmount Decimal? @db.Decimal(38, 18)

  @@unique([userId, ledgerTxId])
  @@index([cantonUpdateId])
  @@index([transferInstructionCid])
  @@index([userId, instrumentId, instrumentAdmin])
}

/// Checkpoint persist untuk stream WSS /v2/updates (CantonUpdatesService).
/// Offset disimpan ke DB supaya restart API TIDAK kehilangan event selama
/// downtime — resume dari offset ini (bukan ledgerEnd). Idempotency replay
/// dijamin oleh WssBalanceApplied + @@unique([userId, ledgerTxId]) di tabel
/// transaksi (pola "beginExclusive per-user persist" — docs Canton
/// Finding & Reading Data / v2-updates).
///
/// L2b: headOffset = HEAD ledger dari pesan OffsetCheckpoint (heartbeat) —
/// KHUSUS pengukuran lag (headOffset − lastOffset), TIDAK untuk resume.
/// Rentang yang diketahui hilang karena pruning dicatat di LedgerStreamGap.
model LedgerStreamCheckpoint {
  streamKey      String   @id // mis. "canton-updates"
  lastOffset     BigInt
  /// HEAD ledger terakhir terlihat dari heartbeat (lag = head − last). Nullable: sebelum heartbeat pertama.
  headOffset     BigInt?
  headUpdatedAt  DateTime?
  updatedAt      DateTime @updatedAt
}

/// L2b — rentang offset stream yang DIKETAHUI hilang permanen karena pruning
/// node (checkpoint ≤ participantPrunedUpToInclusive saat resume). Persist di
/// DB — bukan hanya log — supaya masih bisa ditanyakan berbulan-tahun kemudian
/// saat ada yang bertanya kenapa riwayatnya bolong. Log pm2 terputar habis;
/// baris ini tidak.
model LedgerStreamGap {
  id          String   @id @default(cuid())
  streamKey   String
  /// Offset pertama yang hilang (inklusif) = checkpoint + 1.
  fromOffset  BigInt
  /// Offset terakhir yang hilang (inklusif) = prunedUpToInclusive.
  toOffset    BigInt
  /// Sementara satu-satunya penyebab yang diketahui.
  reason      String   @default("checkpoint-behind-pruning")
  detectedAt  DateTime @default(now())

  @@index([streamKey, detectedAt])
}

/// Guard idempotensi apply balance oleh WSS handler (BalanceEventHandler).
/// Satu baris = satu (updateId, userId, scope) yang SUDAH di-apply ke
/// CcBalance / CantexTokenBalance. Insert-BEFORE-apply (fail-closed): replay
/// setelah restart (resume checkpoint) tidak akan double-credit saldo; kalau
/// crash di antara, saldo miss sekali lalu dikoreksi reconciler — lebih aman
/// daripada double-credit.
model WssBalanceApplied {
  id        String   @id @default(cuid())
  updateId  String
  userId    String
  /// "cc" atau "token:<instrumentId>:<instrumentAdmin>" (lowercase).
  scope     String
  appliedAt DateTime @default(now())

  @@unique([updateId, userId, scope])
  @@index([userId])
}

// ─── L4: pipeline paralel ledger-derived activity ───────────────────────────
// Raw layer + proyeksi baru (spec Part B §4 + koreksi Phase 4 #1: raw layer
// TIDAK di-key per party — stream wildcard menyimpan update apa adanya,
// sekali; atribusi party terjadi di proyeksi L6 dan bisa di-derive ulang
// kapan pun tanpa menyentuh ledger).

/// Envelope mentah satu update transaksi — kebenaran tak terubahkan dari
/// stream /v2/updates (LEDGER_EFFECTS). LedgerEvent (event ternormalisasi)
/// bisa dibangun ulang dari sini kapan pun; dua-duanya disimpan karena
/// ukurannya trivial (≤75 MB untuk 3 bulan) dan query L6 jadi murah.
model LedgerUpdate {
  updateId       String   @id
  /// Offset transaksi. Kolom "offset_" — OFFSET adalah keyword SQL.
  offset         BigInt   @map("offset_")
  recordTime     DateTime
  commandId      String?
  synchronizerId String?
  /// JSON envelope lengkap apa adanya (update.Transaction.value).
  envelope       Json
  ingestedAt     DateTime @default(now())

  @@index([offset])
  @@index([recordTime])
}

/// Event ternormalisasi dari satu update — SATU BARIS PER EVENT, bukan per
/// party. witnessParties disimpan sebagai array; atribusi ke user = query
/// L6 via User.cantonPartyId (resolver ketat, L1) — TIDAK saat menulis raw.
model LedgerEvent {
  updateId       String
  /// Index event dalam update (posisi di array events / eventsById).
  eventIndex     Int
  offset         BigInt   @map("offset_")
  recordTime     DateTime
  /// created | archived | exercised
  eventType      String
  templateId     String?
  /// Nama choice (hanya eventType=exercised).
  choice         String?
  contractId     String?
  /// Party yang menyaksikan event ini (pre-compute Canton) — array, tanpa atribusi user.
  witnessParties String[]
  /// Event mentah (CreatedEvent | ArchivedEvent | ExercisedEvent object).
  payload        Json
  ingestedAt     DateTime @default(now())

  @@id([updateId, eventIndex])
  @@index([contractId])
  @@index([offset])
  @@index([templateId])
}

/// Identitas instrumen token — NEVER key pada bare id (siapa pun bisa mint
/// token ber-id "USDC"). Diisi di langkah pasca-L5 dari data raw (bukan
/// konstanta ketik-manual), lalu di-allowlist secara eksplisit.
model Instrument {
  /// Admin party (mis. DSO::1220… / registrar USDC).
  admin         String
  id            String
  symbol        String?
  displayName   String?
  decimals      Int?
  isAllowlisted Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@id([admin, id])
}

/// Proyeksi activity per-party — ditulis HANYA oleh klasifier L6 (satu
/// penulis; controller tidak menulis baris ledger-derived lagi). Digabung
/// dengan app-activity lama (CcTransaction dkk.) hanya saat display.
model Activity {
  partyId          String
  /// TransferInstruction cid (dua-langkah) atau updateId (one-step) — stabil sepanjang lifecycle.
  activityId       String
  /// transfer | reward | mint | burn
  kind             String
  /// in | out
  direction        String?
  instrumentAdmin  String
  instrumentId     String
  amount           Decimal  @db.Decimal(38, 10)
  fee              Decimal? @db.Decimal(38, 10)
  counterparty     String?
  memo             String?
  /// pending | completed | rejected | withdrawn | failed — TIDAK PERNAH "expired"
  /// (expired = derivasi display dari executeBefore, spec §7).
  status           String
  executeBefore    DateTime?
  correlationId    String?
  createdUpdateId  String
  createdAt        DateTime
  settledUpdateId  String?
  settledAt        DateTime?
  /// Offset event terakhir yang mempengaruhi baris — guard monotonic status.
  lastOffset       BigInt

  @@id([partyId, activityId])
  @@index([partyId, createdAt(sort: Desc), activityId(sort: Desc)])
  @@index([instrumentAdmin, instrumentId])
  @@index([status, executeBefore])
}

/// Tipe event TokenTransaction (P2P token transfer on-chain, CIP-0056).
enum TokenTxType {
  /// Sender mengirim token (offer dibuat di on-chain).
  TOKEN_TRANSFER_OUT
  /// Receiver menerima token setelah accept TransferInstruction.
  TOKEN_TRANSFER_IN
  /// Offer dibuat, menunggu accept (intermediate state, opional).
  TOKEN_OFFER_PENDING
  /// Receiver menolak TransferInstruction (token kembali ke sender).
  TOKEN_OFFER_REJECTED
  /// Sender menarik kembali TransferInstruction yang belum di-accept.
  TOKEN_OFFER_WITHDRAWN
  /// Fee CC keluar untuk P2P token transfer (fee in CC, reuse TRANSACTION_FEE_CC).
  TOKEN_FEE_OUT
  /// Reward token (mis. USDCx) masuk dari reward wallet quest/campaign (user-side, kredit).
  /// Paralel dgn CcTransactionType.QUEST_REWARD untuk token non-CC.
  QUEST_REWARD
}

/// Audit trail lengkap untuk setiap swap CC ↔ token Cantex DEX (multi-leg).
model SwapTransaction {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "CC_TO_TOKEN" (swap CC → token) | "TOKEN_TO_CC" (swap token → CC).
  direction           String
  /// Instrumen yang dijual.
  sellInstrumentId    String
  sellInstrumentAdmin String
  sellAmount          Decimal   @db.Decimal(38, 18)
  /// Instrumen yang dibeli.
  buyInstrumentId     String
  buyInstrumentAdmin  String
  /// Jumlah yang dibeli — null sampai Cantex SwapExecuted event diterima.
  buyAmount           Decimal?  @db.Decimal(38, 18)
  /// Cantex pool contract id (opsional, untuk referensi).
  poolContractId      String?
  /// id dari /v1/intent/build/pool/swap (build response).
  cantexSubmissionId  String?
  /// Canton update id untuk leg CC (transfer user↔trading account).
  ccLedgerTxId        String?
  /// PENDING (sedang diproses) | EXECUTED (sukses) | FAILED (gagal).
  status              String    @default("PENDING")
  /// Idempotency key dari client — mencegah double-submit swap yang sama.
  clientNonce         String    @unique
  swapExecutedAt      DateTime?
  errorMessage        String?
  createdAt           DateTime  @default(now())

  /// Delivery tertunda bila token/CC gagal dikirim on-chain ke user.

  @@index([userId, createdAt])
}

/// CC Lock (non-custodial) — metadata untuk LockedAmulet on-chain.
/// Jumlah terkunci (sumber kebenaran) tetap dari on-chain (findLockedAmulets /
/// effective_locked_qty); tabel ini hanya untuk term, kapan boleh unlock, cid, audit + UI.
/// Spec CC Lock — CanQuest.
model CcLock {
  id              String    @id @default(cuid())
  ownerParty      String // party id user (mis. verify::1220...)
  userId          String? // id user dapp (untuk join), jika ada
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  amountCc        Decimal   @db.Decimal(20, 10)
  termKey         String // mis. "15d" atau "5m" (uji)
  lockSeconds     Int // durasi efektif dalam detik
  lockedAt        DateTime  @default(now())
  expiresAt       DateTime // lockedAt + lockSeconds
  status          String    @default("LOCKED") // LOCKED | UNLOCKED
  lockedAmuletCid String?   @unique
  unlockedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([ownerParty, status])
}

/// Quest campaign dibuat oleh admin/operator.
///
/// SINGLETON: paling banyak satu quest dengan questKind = 'EARN_HUB'. Prisma
/// tidak mengekspress partial unique index, jadi constraint dipegang DB-level
/// oleh partial unique index "quest_earn_hub_singleton" (lihat migration
/// 20260722120000_earn_hub_singleton_unique). App-layer findFirst guard di
/// admin.service tetap sebagai defense-in-depth.
model Quest {
  id                 String            @id @default(cuid())
  title              String
  /// Short partner name for social task titles (Follow X, Join Discord, etc.). Falls back to title when empty.
  projectName        String?
  org                String
  orgSlug            String
  description        String
  banner             String            @default("linear-gradient(135deg,#1e293b,#0f172a)")
  /// Optional image URL (e.g. /quest-media/uuid.webp) shown as quest card/header banner; overrides gradient when set.
  bannerImageUrl     String?
  /// Square project logo; falls back to org initials when absent.
  logoUrl            String?
  rewardCc           Float             @default(0)
  /// Token reward campaign ini. "CC" = Amulet (default); "USDCx" = utility-registry.
  /// Fee claim tetap CC (lihat claimFeeCc). rewardToken hanya menentukan token REWARD-nya.
  rewardToken        String            @default("CC")
  rewardPool         String            @default("0 CC")
  deadline           String?
  /// Optional ISO timeline — quest hidden before startsAt / after endsAt when set.
  startsAt           DateTime?
  endsAt             DateTime?
  status             QuestStatus       @default(ACTIVE)
  tags               String            @default("[]")
  /// JSON array of { platform, url } — shown under About on campaign detail (admin-configured).
  socialLinks        String            @default("[]")
  /// Reward category: waitlist email, random invite, FCFS invite, CC, or CC + invite
  rewardType         RewardType        @default(CC_ONLY)
  /// Max number of winners (null = unlimited / all completers rewarded)
  maxWinners         Int?
  /// CC_AND_CODE_RAFFLE: berapa pemenang yang dapat CODE (sisanya dapat CC). Null = semua pemenang dapat keduanya (perilaku lama).
  codeWinnersQuota   Int?
  /// On-chain claim fee (CC) before user receives code/CC; null = use reward-type default (2 code / 3 token FCFS).
  claimFeeCc         Float?
  /// Custom message shown to raffle/email winners (admin dashboard).
  winnerMessage      String?
  /// Link register/landing proyek untuk redeem code (shown in "How to use your code" reveal).
  redeemUrl          String?
  /// Instruksi custom redeem (multi-line). Kosong = pakai template 3-step default (Register → Use code → Done).
  redeemInstructions String?
  /// CAMPAIGN = partner campaigns (user menu Earn). EARN_HUB = CanQuest daily tasks (user menu Quest).
  questKind          QuestKind         @default(CAMPAIGN)
  /// DAML QuestCampaign contract ID on Canton ledger (set after admin creates quest).
  /// Used by claimFcfsSlot() / drawRaffleWinner() to reference the on-chain campaign.
  /// v29 dedupe (pengganti contract keys): unique — 1 quest ↔ 1 kontrak on-chain.
  ledgerCampaignId   String?           @unique
  /// Version-pinning (cutover v28→v29): nama paket DAML kontrak on-chain
  /// (mis. 'canquest-v29'). Null + ledgerCampaignId terisi = dibuat backend
  /// lama = 'canquest-v28' — claim path memilih template/payload per versi.
  ledgerPackage      String?
  /// v30: T1 (70% durasi) tercapai — pendaftaran ditutup otomatis oleh job;
  /// lock baru ditolak & lock peserta sudah diverifikasi ulang saat timestamp ini.
  v30RegistrationClosedAt DateTime?
  /// Mode gate akses Earn per-campaign (configurable dari dashboard admin).
  /// CC_OR_POINTS (default) = lock CC atau spend points (perilaku lama).
  /// CC_ONLY / POINTS_ONLY / NONE = admin pilih per-event.
  entryGateMode      EntryGateMode     @default(CC_OR_POINTS)
  /// Override jumlah CC yang harus di-lock (jalur cc_lock). Null = pakai default global (LOCK_TIER_FULL, 30).
  entryCcLock        Int?
  /// Override biaya points (jalur points). Null = pakai default global (earn_entry_cost_points AppSetting / 200).
  entryCostPoints    Int?
  /// v25 DAML eligibility type utk on-chain claim guard. Backend map dari entryGateMode:
  ///   CC_ONLY → "LOCK_CC", POINTS_ONLY → "POINTS", CC_OR_POINTS/NONE → "NONE".
  /// "NONE" = siapa saja bisa klaim (no on-chain eligibility check).
  eligibilityType    String            @default("NONE")
  /// v25 DAML min amount utk eligibility (CC locked utk LOCK_CC, points utk POINTS). 0 bila NONE.
  /// Backend isi dari entryCcLock (LOCK_CC) atau entryCostPoints (POINTS).
  eligibilityAmount  Float             @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tasks              QuestTask[]
  completions        QuestCompletion[]
  submissions        QuestSubmission[]
  inviteCodes        InviteCodePool[]
  winnerDraws        WinnerDraw[]
  /// v30: lock proposal per-campaign (jalur eligibility lock CC).
  lockProposals      LockProposalRecord[]
  /// Optional ecosystem partner link — when set, org/logo/social are denormalized from Partner at admin save time.
  partnerId          String?
  partner            Partner?          @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

/// Ecosystem partner profile — shown on /ecosystem directory (off-chain, admin-managed).
/// Quests may optionally link to a partner (Quest.partnerId); partner edits never touch DAML.
model Partner {
  id           String        @id @default(cuid())
  name         String
  /// Display name fallback for logo square when logoUrl absent.
  initials     String
  /// Square logo URL (e.g. /partner-media/uuid.webp); falls back to initials.
  logoUrl      String?
  /// Category value — references EcosystemCategory.value (managed in admin panel).
  category     String
  /// Multi-kategori (tags) — kumpulan EcosystemCategory.value; `category` = yang pertama (primary).
  categories   String[]      @default([])
  /// Free-text description shown on the About tab of partner detail.
  about        String        @default("")
  website      String?
  /// JSON array of { platform, url } — social media row under partner name.
  socialLinks  String        @default("[]")
  /// JSON array of { initials, name, role, socials: [{platform,url}] } — Team tab.
  team         String        @default("[]")
  /// JSON array of { name, description, url } — App Featured tab.
  appsFeatured String        @default("[]")
  /// JSON array of { title, description } — Features tab (partner highlights).
  features     String        @default("[]")
  /// JSON array of { label, partyId, network, status, explorerUrl } — Validator tab (party ID cards).
  validators   String        @default("[]")
  /// When false, hidden from /ecosystem (admin draft toggle).
  published    Boolean       @default(true)
  /// Featured App badge — tombol biru "Featured App" setelah nama partner (admin toggle).
  featuredApp  Boolean       @default(false)
  /// Denormalized like counter (toggled via PartnerLike rows, one per user).
  likes        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  /// Quests linked to this partner (optional — legacy quests have none).
  quests       Quest[]
  likesBy      PartnerLike[]
}

/// Ecosystem directory categories — fully admin-managed (dropdown + tags).
model EcosystemCategory {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One like per user per partner (toggle; keeps Partner.likes counter honest).
model PartnerLike {
  partnerId String
  userId    String
  createdAt DateTime @default(now())
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([partnerId, userId])
}

enum RewardType {
  WAITLIST_EMAIL
  INVITE_CODE_RANDOM
  INVITE_CODE_FCFS
  CC_ONLY
  /// Raffle CC — admin draw after event; winners claim on-chain
  CC_MANUAL
  CC_AND_INVITE
  /// Combined raffle: winners get both CC reward AND an invite code in one event; each claim costs 5 CC
  CC_AND_CODE_RAFFLE
  /// @deprecated Use INVITE_CODE_RANDOM — kept for existing rows
  INVITE_CODE
}

/// Pool of invite codes for a quest (admin uploads these).
model InviteCodePool {
  id         String    @id @default(cuid())
  questId    String
  quest      Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  code       String    @unique
  /// Assigned to this user (null = not yet distributed)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  assignedAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Records winner selection for a quest draw.
model WinnerDraw {
  id                     String    @id @default(cuid())
  questId                String
  quest                  Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CC amount that was (or will be) sent to this winner
  ccAmount               Float     @default(0)
  /// Token reward untuk winner ini. "CC" (default) atau "USDCx". Mirror Quest.rewardToken saat slot di-reserve.
  rewardToken            String    @default("CC")
  /// Invite code assigned (if applicable)
  inviteCode             String?
  /// CC_AND_CODE_RAFFLE: varian reward pemenang — 'CODE' atau 'CC'. Null = varian lama (keduanya) untuk kompatibilitas.
  rewardVariant          String?
  /// Whether the reward has been distributed on-chain
  distributed            Boolean   @default(false)
  /// Canton ledger TX id after CC distribution
  ledgerTxId             String?
  /// TransferOffer id for user-paid claim fee (invite/code or FCFS claim).
  claimFeeLedgerTxId     String?
  /// DAML ClaimSession contract id (audit/state machine).
  claimSessionContractId String?
  drawnAt                DateTime  @default(now())
  distributedAt          DateTime?
  /// Set while on-chain FCFS claim runs (prevents parallel double-claim / double payout).
  fcfsClaimLockedAt      DateTime?
  /// v29 dedupe (pengganti contract keys): claimId yang dikirim ke
  /// ClaimSlot/DrawWinner on-chain. Jalur FCFS/raffle = WinnerDraw.id (unik
  /// via PK); jalur invite = "code-<drawId|questId:userId>" (deterministik,
  /// di-persist di sini agar retry ter-dedupe DB-level).
  claimId                String?   @unique

  // ── v30 (canquest-claim): ClaimOffer / ClaimReceipt mirror ──────────────
  /// ClaimOffer contract id (Main:ClaimOffer) — dibuat backend actAs
  /// [validator, rewardSender] saat draw / FCFS claim. Unique = 1 offer
  /// on-chain per winner (jaring anti double-offer; kontrak v30 tidak punya
  /// contract key — DB satu-satunya jaring, SECURITY.md §3.1).
  offerContractId        String?   @unique
  /// ClaimReceipt contract id (Main:ClaimReceipt) — lahir saat user Accept*.
  receiptContractId      String?
  /// Mirror ClaimStatus on-chain: Settled | RewardPending | RewardExpired | Revealed.
  /// Sinkron dari transaction tree saat accept + job monitor RewardPending.
  claimStatus            String?
  /// ClaimOffer.validUntil = waktu UNDIAN + 48 jam (BUKAN waktu campaign) —
  /// AGENT.md: kalau undian mundur, offer lahir kedaluwarsa. UI "Claim before ...".
  validUntil             DateTime?
  /// RewardKind yang dikomit di offer: CODE_ONLY | TOKEN_ONLY | TOKEN_AND_CODE.
  rewardKind             String?
  /// Kode plaintext setelah RevealCode sukses (dipaparkan ke user di UI Revealed).
  revealedCode           String?
  /// Waktu status reward final (ConfirmRewardReceived / MarkRewardExpired) — audit.
  rewardClosedAt         DateTime?
  /// Reminder RewardPending terakhir terkirim (hari ke-3 / ke-8, UI-STATES.md).
  rewardPendingNotifiedAt DateTime?

  @@unique([questId, userId])
}

/// Task individual dalam sebuah quest.
model QuestTask {
  id             String            @id @default(cuid())
  questId        String
  quest          Quest             @relation(fields: [questId], references: [id], onDelete: Cascade)
  type           String
  title          String
  description    String?
  points         Int               @default(10)
  target         String?
  order          Int               @default(0)
  /// Jawaban benar untuk tipe quiz (opsional)
  correctAnswer  String?
  /// Tampilkan badge "NEW" di halaman Quest user
  showNewBadge   Boolean           @default(false)
  /// Task tetap tampil; user bisa dapat poin lagi setiap 24 jam (daily check-in selalu aktif)
  repeatEvery24h Boolean           @default(false)
  createdAt      DateTime          @default(now())
  submissions    QuestSubmission[]
}

/// Submission satu task oleh satu user.
model QuestSubmission {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest            @relation(fields: [questId], references: [id], onDelete: Cascade)
  taskId      String
  task        QuestTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Bukti dari user: URL, handle, jawaban, dll.
  proof       String?
  status      SubmissionStatus @default(PENDING)
  /// Canton ledger TX ID dari CC reward = Proof of Execution on-chain
  ledgerTxId  String?
  submittedAt DateTime         @default(now())
  verifiedAt  DateTime?

  @@unique([userId, taskId])
}

/// Penamaan historis (nilai DB tetap, JANGAN rename — akan pecah data & wire FE↔BE):
/// - CAMPAIGN  = menu EARN    (/earn)   → partner campaigns
/// - EARN_HUB  = menu QUEST   (/quests) → CanQuest daily/social tasks hub
/// Lihat docs/EARN_FLOW_CURRENT.md. Kode FE identifier sudah pakai "questHub".
enum QuestKind {
  CAMPAIGN
  EARN_HUB
}

/// Mode gate akses Earn per-campaign (di-set admin per-event).
/// CC_OR_POINTS = lock CC ATAU spend points (default, perilaku lama).
/// CC_ONLY = hanya lock CC. POINTS_ONLY = hanya spend points. NONE = tanpa gate (event gratis).
enum EntryGateMode {
  CC_OR_POINTS
  CC_ONLY
  POINTS_ONLY
  NONE
}

enum QuestStatus {
  ACTIVE
  COMING_SOON
  ENDED
}

enum SubmissionStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Account access state. ACTIVE = full access (default for all existing users).
/// Enforcement (phase 1): login & refresh reject non-ACTIVE; ban/suspend revoke all sessions.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

/// Jenis email notifikasi campaign (Resend). String literal TS-nya ada di
/// common/prisma-types.ts (konvensi repo — hindari import enum @prisma/client).
enum EmailNotificationType {
  CAMPAIGN_ANNOUNCEMENT
  CAMPAIGN_WINNER
  CAMPAIGN_NOT_SELECTED
}

/// Status kirim per email (outbox pattern — worker Bull update setelah kirim).
enum EmailNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Key-value store untuk konfigurasi aplikasi (earn entry cost, dll).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Tracks which quests each user has completed.
model QuestCompletion {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId                 String
  quest                   Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  /// CC reward in micro-CC already credited from this completion.
  rewardMicroCc           BigInt   @default(0)
  /// Token reward untuk completion ini. "CC" (default) atau "USDCx".
  rewardToken             String   @default("CC")
  /// Jumlah token non-CC (mis. USDCx) yang sudah dikredit. Null = reward CC (pakai rewardMicroCc).
  /// Presisi Decimal(38,18) — berbeda dgn micro-CC. Dipakai hanya saat rewardToken = "USDCx".
  rewardTokenAmount       Decimal? @db.Decimal(38, 18)
  /// Canton ledger TX ID dari CC reward = bukti on-chain
  ledgerTxId              String?
  /// DAML QuestParticipation contract id (if recorded on ledger)
  ledgerParticipationId   String?
  /// DAML QuestReward contract id (if recorded on ledger)
  ledgerRewardId          String?
  /// DAML QuestTaskSubmission contract ids (JSON string array)
  ledgerTaskSubmissionIds Json     @default("[]")
  completedAt             DateTime @default(now())

  @@unique([userId, questId])
}

/// Pending delivery — token/CC yang swap-nya sukses tapi gagal dikirim
/// on-chain ke user party (mis. transfer offer tak ter-accept, network error).
/// User bisa accept/reject via UI, admin bisa refund/retry.
/// Replaces the old "fallback off-chain credit" pattern (source of balance drift).
// ─── v25: DAML CampaignEligibility contract tracking ───────────────────────
// Mirror on-chain CampaignEligibility contract (LOCK_CC / POINTS eligibility proof).
// Dibuat backend SETELAH verifikasi lock CC / points utk quest claim.
// Source of truth on-chain; tabel ini cache + lookup utk eligibilityCid di claim path.
model CampaignEligibilityLedger {
  id              String    @id @default(cuid())
  questId         String
  userId          String
  /// DAML CampaignEligibility contract id (Main:CampaignEligibility).
  contractId      String    @unique
  /// "LOCK_CC" | "POINTS" (match DAML eligibilityType).
  eligibilityType String
  /// Jumlah CC locked atau points (match DAML amount field).
  amount          Float
  /// Timestamp lock CC (LOCK_CC); null bila POINTS. Source: ccLocks.lockedAt.
  lockedAt        DateTime?
  /// "ELIGIBLE" | "REVOKED" | "EXPIRED" (match DAML status).
  status          String    @default("ELIGIBLE")
  /// v29 [FIX-11]: lockId yang dicocokkan on-chain dgn CoinLock.lockId
  /// (format "lock:<questId>:<userId>", deterministik). Null utk POINTS.
  lockId          String?
  /// v29: CoinLock contract id (Main:CoinLock) utk choice arg ClaimSlot/DrawWinner.
  coinLockCid     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([questId, userId])
  @@index([userId, status])
  @@index([questId, status])
  @@index([lockId])
}

/// v30 (canquest-lock): mirror LockProposal / LockReceipt on-chain — sumber
/// eligibility campaign (jalur lock CC). SATU lock per (quest, user)
/// (constraint) — pengganti v29 CampaignEligibilityLedger utk quest v30.
///
/// contextRef = token opaque CSPRNG yang jadi TimeLock.optContext. optContext
/// PUBLIK di ledger — JANGAN pernah berbentuk "canquest:campaign-42"
/// (LOCK-SPEC.md §245); mapping contextRef→campaign hanya hidup di tabel ini.
///
/// holders lock = [validator] (bukan user!) — LockedAmulet_UnlockV2 tanpa cek
/// waktu akan runtuh gerbang eligibility bila holders diisi user. Verifikasi
/// pasca-AcceptLock + re-verifikasi di T1 (registration close) — SECURITY.md §3.2.
model LockProposalRecord {
  id                  String    @id @default(cuid())
  questId             String
  quest               Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Token opaque CSPRNG — TimeLock.optContext on-chain. @unique = 1 lock 1 token.
  contextRef          String    @unique
  /// LockProposal contract id (LockProposal:LockProposal) — dibuat backend actAs [validator].
  proposalContractId  String    @unique
  /// LockReceipt contract id — lahir saat user AcceptLock.
  receiptContractId   String?
  /// LockedAmulet contract id — dari hasil AcceptLock, diverifikasi via interface HoldingV2.
  lockedAmuletCid     String?   @unique
  /// Ambang campaign (mis. 30 CC) — harus == lock.amount on-chain saat verify.
  amountCc            Decimal   @db.Decimal(20, 10)
  /// T2 = campaign end. lock.holders=[validator] sampai lewat waktu ini;
  /// user baru bisa OwnerExpireLockV2 SETELAHnya (assertDeadlineExceeded).
  expiresAt           DateTime
  /// Jendela pendek user harus tanda tangan AcceptLock (±10 menit —
  /// jendela prepare→submit CC, LockProposal.daml proposalExpiresAt).
  proposalExpiresAt   DateTime
  /// PROPOSED | ACCEPTED | UNLOCKED | REVOKED
  /// REVOKED = re-verifikasi T1 gagal (early-unlock via UnlockV2 disetujui /
  /// holding tidak lagi aktif). LockReceipt sengaja BUKAN sumber eligibility.
  status              String    @default("PROPOSED")
  proposalWithdrawnAt DateTime?
  acceptedAt          DateTime?
  unlockedAt          DateTime?
  revokedAt           DateTime?
  revokedReason       String?
  /// UpdateId transaksi AcceptLock — audit trail.
  acceptUpdateId      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([questId, userId])
  @@index([userId, status])
  @@index([questId, status])
  @@index([expiresAt, status])
}

// ─── L5.0: baseline rekonsiliasi L9 ─────────────────────────────────────────
// Snapshot ACS pada offset TITIK NOL node (819747, 2026-06-08) — diambil
// sekali selagi pruned=0; activeAtOffset historis tidak bisa dilayani lagi
// begitu node pernah memangkas. Dipakai L9: pembuka + Σnet == ACS kini.
// firstSeenOffset (dari flats) menjawab definitif: party lahir sebelum /
// sesudah titik nol. Mencakup SEMUA party di DB (aktif + legacy) — superset
// dari sembilan party yang diminta; baseline lengkap lebih murah sekarang.
model AcsOpeningBalance {
  partyId         String   @id
  atOffset        BigInt
  takenAt         DateTime @default(now())
  /// Offset transaksi pertama party ini sejak 819747 (null = belum pernah
  /// transaksi terlihat). partyId dengan holdings non-kosong ATAU firstSeen <
  /// atOffset → lahir SEBELUM titik nol.
  firstSeenOffset BigInt?
  /// Daftar holding penuh per kontrak saat snapshot (cid/template/instrumen/amount).
  holdings        Json
  /// Agregat amount per (instrumentAdmin, instrumentId).
  sums            Json
}

// ─── v25: DAML PlatformTransfer contract tracking ──────────────────────────
// Mirror on-chain PlatformTransfer contract (atomic send + platform fee).
// Dibuat backend saat user send token dgn platform fee (feature flag on).
// Replaces non-atomic sendCc path (2 transfer terpisah) bila QUEST_ATOMIC_PLATFORM_TRANSFER=true.
// ─── v32: Email notification outbox (Resend) ────────────────────────────────
// Satu baris = satu email campaign untuk satu user. Hook admin (createQuest /
// drawWinners / updateQuest→ENDED) membuat baris PENDING; worker Bull queue
// `email-jobs` mengirim via Resend batch lalu update status SENT/FAILED/SKIPPED.
//
// @@unique([userId, questId, type]) = idempotency: draw bertahap, hook
// terpanggil dua kali (create + COMING_SOON→ACTIVE), atau Bull retry tidak
// pernah mengirim email yang sama dua kali untuk user yang sama.
model EmailNotificationLog {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId   String
  /// Snapshot alamat email saat enqueue (audit — email user bisa berubah).
  email     String
  type      EmailNotificationType
  status    EmailNotificationStatus @default(PENDING)
  /// Snapshot data template (judul quest, reward label, dst) — worker tidak
  /// perlu re-query quest; konten email dibekukan per penerima.
  payload   Json?
  /// Resend email id (trace di dashboard Resend).
  resendId  String?
  error     String?
  createdAt DateTime                @default(now())
  sentAt    DateTime?

  @@unique([userId, questId, type])
  @@index([questId, type, status])
  @@index([status, createdAt])
}
